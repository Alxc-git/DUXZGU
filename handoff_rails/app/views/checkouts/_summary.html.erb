<% subtotal = 39.99 * qty %>
<% addon = 33.99 %>
<% total = subtotal + addon - 6.00 %>

<div class="stack">
  <div class="card">
    <div style="display:flex;align-items:baseline;margin-bottom:var(--space-4)">
      <h2 style="font-size:var(--fs-title)">Your cart (<%= qty %>)</h2>
      <%= link_to "Edit cart", product_path(flavor: flavor.slug, qty: qty),
            style: "margin-left:auto;font-size:var(--fs-caption)" %>
    </div>
    <div class="checkout__item">
      <span class="checkout__thumb" style="background:<%= flavor.spot_var %>,var(--ink-100)">
        <%= image_tag flavor.image, alt: "" %>
      </span>
      <div style="min-width:0;flex:1">
        <div class="stat__label"><%= flavor.name %> Creatine Jelly</div>
        <div class="stat__note">5000 mg creatine monohydrate · 32 servings</div>
        <div style="display:flex;align-items:center;gap:12px;margin-top:10px;flex-wrap:wrap">
          <span class="qty" data-qty>
            <button type="button" data-qty-dec aria-label="Decrease"><%= cj_icon "minus" %></button>
            <span class="qty__val" data-qty-val><%= qty %></span>
            <button type="button" data-qty-inc aria-label="Increase"><%= cj_icon "plus" %></button>
          </span>
          <span style="font-family:var(--font-display);color:var(--accent);font-size:1.25rem">
            $<%= "%.2f" % subtotal %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="card card--accent">
    <p class="eyebrow eyebrow--accent" style="margin-bottom:12px">Add blueberry &amp; save 15%</p>
    <div style="display:flex;gap:14px;align-items:center">
      <%= image_tag "product/jar-blueberry.png", alt: "", style: "width:70px" %>
      <div style="flex:1;min-width:0">
        <div class="stat__label">Blueberry Creatine Jelly</div>
        <div class="stat__note">30 servings</div>
        <div style="margin-top:6px;display:flex;gap:8px;align-items:baseline">
          <s style="color:var(--text-faint);font-size:var(--fs-caption)">$39.99</s>
          <span style="font-family:var(--font-display);color:var(--accent);font-size:1.125rem">$33.99</span>
        </div>
      </div>
    </div>
    <label class="check" style="margin-top:10px">
      <input type="checkbox" name="addon" checked>
      <span class="check__box"><%= cj_icon "check" %></span>
      <span>Yes! Add blueberry &amp; save 15%</span>
    </label>
  </div>

  <div class="card">
    <h2 style="font-size:var(--fs-title);margin-bottom:var(--space-4)">Order summary</h2>
    <div class="checkout__section" style="gap:10px">
      <div class="checkout__line"><span>Subtotal</span><b>$<%= "%.2f" % (subtotal + addon) %></b></div>
      <div class="checkout__line"><span>Shipping</span><b>Free</b></div>
      <div class="checkout__line checkout__line--discount"><span>Discount (SAVE15)</span><b>−$6.00</b></div>
      <hr class="rule">
      <div class="checkout__line checkout__line--total"><span>Total</span><span>$<%= "%.2f" % total %></span></div>
      <div class="promo">
        <input class="input" placeholder="Promo code">
        <span class="btn btn--secondary">Apply</span>
      </div>
    </div>
  </div>

  <div class="card">
    <div style="display:flex;gap:14px;align-items:flex-start">
      <span class="feature-icon"><%= cj_icon "shield-check" %></span>
      <div>
        <div class="stat__label">100% safe &amp; secure checkout</div>
        <div class="stat__note">Your information is protected with 256-bit SSL encryption.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <p class="eyebrow eyebrow--accent" style="margin-bottom:12px">Need help with your order?</p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-6)">
      <div class="trust__item"><%= cj_icon "message-circle" %><span><span class="trust__t">Live chat</span>Mon–Fri 9AM–6PM EST</span></div>
      <div class="trust__item"><%= cj_icon "mail" %><span><span class="trust__t">Email us</span>support@creatinejelly.com</span></div>
    </div>
  </div>
</div>
