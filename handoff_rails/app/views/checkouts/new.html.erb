<% content_for :hide_footer, true %>
<% content_for :hide_buy_bar, true %>

<div class="page stack" style="padding-top:var(--space-8)">
  <%= render "checkouts/steps", current: 1 %>

  <div class="card" style="display:flex;flex-wrap:wrap;gap:var(--space-5);align-items:center">
    <span class="feature-icon feature-icon--lg"><%= cj_icon "shield-check" %></span>
    <div style="flex:1 1 240px">
      <div class="stat__label" style="font-size:1.0625rem">You're one step away from stronger, faster, better.</div>
      <div class="stat__note">Every order is protected by our 30-day money back guarantee.</div>
    </div>
    <span class="badge badge--outline" style="padding:10px 14px;text-align:center;line-height:1.3">30-day<br>money back guarantee</span>
  </div>

  <%= form_with url: checkout_path, method: :post, class: "checkout", data: { turbo: false } do |form| %>
    <div class="stack">
      <div class="card checkout__section">
        <div style="display:flex;align-items:baseline;gap:12px">
          <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">1. Customer information</p>
          <span style="margin-left:auto;font-size:var(--fs-caption);color:var(--text-muted)">Already have an account? <a href="#">Login</a></span>
        </div>
        <%= form.email_field :email, class: "input", placeholder: "Email address" %>
        <label class="check">
          <%= form.check_box :newsletter, checked: true %>
          <span class="check__box"><%= cj_icon "check" %></span>
          <span>Email me with news and offers</span>
        </label>
      </div>

      <div class="card checkout__section">
        <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">2. Shipping address</p>
        <div class="checkout__grid checkout__grid--2">
          <%= form.text_field :first_name, class: "input", placeholder: "First name" %>
          <%= form.text_field :last_name,  class: "input", placeholder: "Last name" %>
        </div>
        <%= form.text_field :address, class: "input", placeholder: "Street address" %>
        <%= form.text_field :address2, class: "input", placeholder: "Apartment, suite, etc. (optional)" %>
        <div class="checkout__grid checkout__grid--2">
          <%= form.text_field :city,  class: "input", placeholder: "City" %>
          <%= form.text_field :state, class: "input", placeholder: "State / Province" %>
        </div>
        <div class="checkout__grid checkout__grid--2">
          <%= form.text_field :zip, class: "input", placeholder: "ZIP / Postal code" %>
          <span class="select">
            <%= form.select :country, ["United States", "Canada", "United Kingdom", "France"], {}, class: "input" %>
            <span class="select__chev"><%= cj_icon "chevron-down" %></span>
          </span>
        </div>
        <%= form.telephone_field :phone, class: "input", placeholder: "Phone (for shipping updates)" %>
      </div>

      <div class="card checkout__section">
        <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">3. Shipping method</p>
        <%= render "shared/option", title: "Standard shipping", note: "5–8 business days", price: "Free", selected: true %>
        <%= render "shared/option", title: "Priority shipping", note: "2–3 business days", price: "$4.99", selected: false %>
        <div class="trust__item"><%= cj_icon "truck" %>Orders ship within 24–48 hours</div>
      </div>

      <div class="card checkout__section">
        <div style="display:flex;align-items:baseline;gap:12px">
          <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">4. Payment</p>
          <span style="margin-left:auto;font-size:var(--fs-caption);color:var(--text-muted)">All transactions are secure &amp; encrypted.</span>
        </div>
        <%= render "shared/option", title: "Credit card", selected: true %>
        <div class="checkout__section" style="gap:var(--space-3)">
          <%= form.text_field :card_number, class: "input", placeholder: "Card number" %>
          <div class="checkout__grid checkout__grid--2">
            <%= form.text_field :card_expiry, class: "input", placeholder: "MM / YY" %>
            <%= form.text_field :card_cvc,    class: "input", placeholder: "CVC" %>
          </div>
        </div>
        <%= render "shared/option", title: "PayPal",    selected: false %>
        <%= render "shared/option", title: "Apple Pay", selected: false %>

        <button class="btn btn--primary btn--lg btn--full" type="submit">
          <%= cj_icon "lock", size: "1.15em" %> Place order now
        </button>
        <p style="font-size:var(--fs-caption);color:var(--text-faint);text-align:center">
          By completing your purchase, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
        </p>
      </div>
    </div>

    <%= render "checkouts/summary", flavor: @flavor, qty: @qty %>
  <% end %>

  <div class="card"><%= render "shared/trust_row" %></div>
</div>
