<% content_for :title, "#{t('legal.shipping.title')} | #{current_store.name}" %>
<% window = DispatchWindow.for(current_store) %>
<%= render layout: "pages/legal", locals: { title: t("legal.shipping.title") } do %>
  <h2><%= t("legal.shipping.h1") %></h2>
  <%= legal_p "shipping.p1_html",
        countries: current_store.shipping_countries.map { |c| country_name(c) rescue c }.to_sentence %>

  <h2><%= t("legal.shipping.h2") %></h2>
  <% if current_store.shipping_cents.zero? %>
    <%= legal_p "shipping.free_html" %>
  <% else %>
    <p>
      <%= t("legal.shipping.paid_html",
            amount: MoneyFormatter.format(current_store.shipping_cents, current_store.currency)).html_safe %>
      <% if current_store.free_shipping_threshold? %>
        <%= t("legal.shipping.threshold_html",
              amount: MoneyFormatter.format(current_store.free_shipping_threshold_cents, current_store.currency)).html_safe %>
      <% end %>
      <%= t("legal.shipping.per_parcel") %>
    </p>
  <% end %>

  <h2><%= t("legal.shipping.h3") %></h2>
  <%= legal_p "shipping.p3_html", time: window.cutoff_at.strftime("%-l %p").strip %>

  <h2><%= t("legal.shipping.h4") %></h2>
  <%= legal_p "shipping.p4_html", todo: legal_todo("shipping.todo4") %>

  <h2><%= t("legal.shipping.h5") %></h2>
  <%= legal_p "shipping.p5_html", email: mail_to(current_store.support_email) %>

  <h2><%= t("legal.shipping.h6") %></h2>
  <p><%= t("legal.shipping.p6") %></p>

  <h2><%= t("legal.shipping.h7") %></h2>
  <p><%= t("legal.shipping.p7") %></p>

  <h2><%= t("legal.shipping.h8") %></h2>
  <%= legal_p "shipping.p8_html", todo: legal_todo("shipping.todo8") %>
<% end %>
