<section class="hero hero--scene" style="--hero-flavor:<%= flavor.color_var %>;--hero-spot:<%= flavor.spot_var %>;--hero-focus:<%= flavor.scene_focus %>">
  <div class="hero__bleed">
    <picture>
      <source media="(max-width: 899px)" srcset="<%= storefront_image_srcset(flavor.mobile_scene_image) %>" sizes="calc(100vw - 36px)">
      <%= storefront_image_tag flavor.scene_image, alt: "#{flavor.name} Creatine Jelly", loading: "eager", fetchpriority: "high", sizes: "(min-width: 1360px) 1264px, calc(100vw - 64px)" %>
    </picture>
  </div>
  <span class="hero__veil"></span>

  <div class="hero__in">
    <div class="hero__copy">
      <span class="badge badge--outline"><%= t("store.hero.badge") %></span>

      <h1 class="hero__type">
        <span class="l1"><%= t("store.hero.line1") %></span>
        <span class="l2"><%= t("store.hero.line2") %></span>
      </h1>

      <p class="hero__lede">
        <%= t("store.hero.lede_html").html_safe %>
      </p>

      <div class="hero__proof">
        <%= cj_stars Storefront::RATING, meta: t("store.hero.reviews_meta", rating: Storefront::RATING, count: Storefront::REVIEW_COUNT) %>
        <span class="hero__proof-sep"></span>
        <span class="eyebrow eyebrow--muted"><%= t("store.hero.athletes", count: Storefront::CUSTOMER_COUNT) %></span>
      </div>

      <div class="hero__cta">
        <% if current_product && selected_purchase_variant %>
          <%= button_to cart_lines_path,
                params: buy_now_params(quantity: 1),
                class: "btn btn--primary btn--lg" do %>
            <%= t("store.hero.shop_now") %> - <%= selected_purchase_variant.formatted_price %>
          <% end %>
        <% end %>
        <%= link_to t("store.hero.see_product"), product_page_path, class: "btn btn--glass btn--lg" %>
      </div>

      <hr class="rule rule--dotted" style="width:100%">

      <div class="hero__claims">
        <% Storefront.benefits.each do |benefit| %>
          <%= render "shared/stat", stat: benefit, icon_size: "sm" %>
        <% end %>
      </div>

      <div class="hero__trust"><%= render "shared/trust_row" %></div>
    </div>
  </div>

  <%= render "shared/ticker" %>
</section>
