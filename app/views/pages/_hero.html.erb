<section class="hero hero--scene" data-flavor-theme style="--active-flavor:<%= flavor.color_var %>;--active-spot:<%= flavor.spot_var %>;--hero-focus:<%= flavor.scene_focus %>">
  <div class="hero__bleed">
    <picture>
      <source media="(max-width: 899px)" srcset="<%= storefront_image_srcset(flavor.mobile_scene_image) %>" sizes="calc(100vw - 36px)" data-flavor-hero-mobile>
      <%= storefront_image_tag flavor.scene_image, alt: "#{flavor.name} · DUWZGU Creatine Jelly", loading: "eager", fetchpriority: "high",
            sizes: "(min-width: 1360px) 1264px, calc(100vw - 64px)", data: { flavor_image: "hero" } %>
    </picture>
  </div>
  <span class="hero__veil" aria-hidden="true"></span>
  <div class="hero__in">
  <div class="hero__copy">
    <p class="eyebrow"><span class="hero__dash" aria-hidden="true"></span><%= t("premium.hero.eyebrow") %></p>
    <h1 class="hero__type"><span class="l1"><%= t("store.hero.line1") %></span><span class="l2"><%= t("premium.hero.title_end") %></span></h1>
    <p class="hero__lede"><%= t("premium.hero.lede") %></p>
    <div class="hero__cta">
      <% if current_product && selected_purchase_variant %>
        <%= button_to cart_lines_path, params: buy_now_params(quantity: 1),
              form: { data: { flavor_purchase: true } }, class: "btn btn--primary btn--lg" do %>
          <%= t("premium.hero.cta") %><%= cj_icon "arrow-right" %>
        <% end %>
      <% end %>
      <%= link_to t("store.hero.see_product"), product_page_path, class: "text-link" %>
    </div>
    <div class="hero__pick">
      <span class="eyebrow"><%= t("store.pdp.choose_flavor") %></span>
      <div class="hero__swatches" role="group" aria-label="<%= t("store.pdp.choose_flavor") %>">
        <% Flavor::ALL.each do |item| %>
          <%= link_to url_for(request.params.merge(flavor: item.slug)), class: ["hero__swatch", ("is-selected" if item.slug == flavor.slug)],
                data: flavor_choice_data(item), aria: { label: item.name, current: ("true" if item.slug == flavor.slug) },
                style: "--flavor:#{item.color_var}" do %><span aria-hidden="true"></span><% end %>
        <% end %>
        <span class="hero__flavor-name" data-flavor-text="name"><%= flavor.name %></span>
      </div>
    </div>
    <p class="hero__shipping"><%= cj_icon "truck" %><%= t("store.cta.note") %></p>
  </div>
  </div>
</section>
