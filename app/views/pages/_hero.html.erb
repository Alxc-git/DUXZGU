<section class="hero hero--scene" style="--hero-flavor:<%= flavor.color_var %>;--hero-spot:<%= flavor.spot_var %>;--hero-focus:<%= flavor.scene_focus %>">
  <div class="hero__bleed">
    <picture>
      <source media="(max-width: 899px)" srcset="<%= asset_path flavor.mobile_scene_image %>">
      <%= image_tag flavor.scene_image, alt: "#{flavor.name} Creatine Jelly" %>
    </picture>
  </div>
  <span class="hero__veil"></span>

  <div class="hero__in">
    <div class="hero__copy">
      <span class="badge badge--outline">Premium creatine gummies</span>

      <div class="hero__type">
        <span class="l1">Creatine</span>
        <span class="l2">made easy.</span>
      </div>

      <p class="hero__lede">
        Delicious daily creatine for <b>strength, power, recovery,</b>
        and <b>convenience</b>. Four gummies. That's the whole routine.
      </p>

      <div class="hero__proof">
        <%= cj_stars Storefront::RATING, meta: "#{Storefront::RATING}/5 · #{Storefront::REVIEW_COUNT} reviews" %>
        <span class="hero__proof-sep"></span>
        <span class="eyebrow eyebrow--muted"><%= Storefront::CUSTOMER_COUNT %> athletes</span>
      </div>

      <div class="hero__cta">
        <% if current_product && selected_purchase_variant %>
          <%= button_to cart_lines_path,
                params: buy_now_params(quantity: 1),
                class: "btn btn--primary btn--lg" do %>
            Shop now - <%= selected_purchase_variant.formatted_price %>
          <% end %>
        <% end %>
        <%= link_to "See product", product_page_path(plan: "sub"), class: "btn btn--secondary btn--lg" %>
      </div>

      <hr class="rule rule--dotted" style="width:100%">

      <div class="hero__claims">
        <% Storefront::BENEFITS.each do |benefit| %>
          <%= render "shared/stat", stat: benefit, icon_size: "sm" %>
        <% end %>
      </div>

      <div class="hero__trust"><%= render "shared/trust_row" %></div>
    </div>
  </div>

  <%= render "shared/ticker" %>
</section>
