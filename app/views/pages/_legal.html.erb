<%# Shared shell for the policy pages, so they read as one document family. %>
<div class="page stack" style="padding-top:var(--space-8);max-width:820px">
  <%= render "shared/page_head",
        title: title,
        sub: t("legal.updated", date: (l(Date.current, format: :long) rescue Date.current.strftime("%B %-d, %Y"))) %>

  <div class="card card--pad-lg legal">
    <%= yield %>
  </div>

  <div class="card">
    <div class="trust trust--stack">
      <div class="trust__item"><%= cj_icon "mail" %><span><span class="trust__t"><%= t("legal.questions") %></span><%= current_store.support_email %></span></div>
      <div class="trust__item"><%= cj_icon "shield-check" %><span><span class="trust__t"><%= t("legal.other_policies") %></span>
        <%= link_to t("store.footer.terms"), terms_path %> ·
        <%= link_to t("store.footer.refunds"), refunds_path %> ·
        <%= link_to t("store.footer.shipping_link"), shipping_policy_path %> ·
        <%= link_to t("store.footer.privacy"), privacy_policy_path %></span></div>
    </div>
  </div>
</div>
