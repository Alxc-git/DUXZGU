<% content_for :title, "#{t('legal.terms.title')} | #{current_store.name}" %>
<%= render layout: "pages/legal", locals: { title: t("legal.terms.title") } do %>
  <h2><%= t("legal.terms.h1") %></h2>
  <%= legal_p "terms.p1_html", store: current_store.name, todo: legal_todo("terms.todo1") %>

  <h2><%= t("legal.terms.h2") %></h2>
  <p><%= t("legal.terms.p2") %></p>

  <h2><%= t("legal.terms.h3") %></h2>
  <p><%= t("legal.terms.p3", currency: current_store.currency.to_s.upcase) %></p>
  <p><%= t("legal.terms.p3b") %></p>

  <h2><%= t("legal.terms.h4") %></h2>
  <p><%= t("legal.terms.p4") %></p>

  <h2><%= t("legal.terms.h5") %></h2>
  <%= legal_p "terms.p5_html", link: link_to(t("legal.terms.p5_link"), shipping_policy_path) %>

  <h2><%= t("legal.terms.h6") %></h2>
  <%= legal_p "terms.p6_html", link: link_to(t("legal.terms.p6_link"), refunds_path) %>

  <h2><%= t("legal.terms.h7") %></h2>
  <p><%= t("legal.terms.p7") %></p>

  <h2><%= t("legal.terms.h8") %></h2>
  <p><%= t("legal.terms.p8") %></p>

  <h2><%= t("legal.terms.h9") %></h2>
  <%= legal_p "terms.p9_html", todo: legal_todo("terms.todo9"), email: mail_to(current_store.support_email) %>
<% end %>
