<% window = @first.estimated_delivery_on -%>
<%= @store.name %> — <%= t("mailer.shipped_title") %>

<%= t("mailer.shipped_body", reference: @first.reference) %>
<% if @first.tracked? -%>
<%= t("mailer.tracking_number") %> : <%= @first.tracking_number %>
<% if @first.tracking_url.present? -%>
<%= t("mailer.track_parcel") %> : <%= @first.tracking_url %>
<% end -%>
<% end -%>

<%= t("mailer.arrival_between", from: window.first, to: window.last) %>
<%= t("mailer.first_scan") %>
