<% window = @first.estimated_delivery_on %>
<div style="font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #111111; max-width: 560px; margin: 0 auto; padding: 24px;">
  <p style="font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #6b6b6b; margin: 0 0 6px;">
    <%= @store.name %>
  </p>
  <h1 style="font-size: 24px; margin: 0 0 8px;"><%= t("mailer.shipped_title") %></h1>
  <p style="color: #4a4a4a; line-height: 1.55; margin: 0 0 24px;">
    Le colis de la commande <strong><%= @first.reference %></strong> a quitte l'entrepot.
  </p>

  <% if @first.tracked? %>
    <div style="border: 1px solid #e3e3de; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
      <p style="margin: 0 0 4px; font-size: 13px; color: #6b6b6b;"><%= t("mailer.tracking_number") %></p>
      <p style="margin: 0 0 12px; font-size: 18px; font-weight: 700; letter-spacing: 0.02em;">
        <%= @first.tracking_number %>
      </p>
      <% if @first.tracking_url.present? %>
        <a href="<%= @first.tracking_url %>"
           style="display: inline-block; background: #111111; color: #ffffff; text-decoration: none;
                  padding: 12px 20px; border-radius: 6px; font-weight: 700;">
          <%= t("mailer.track_parcel") %>
        </a>
      <% end %>
    </div>
  <% end %>

  <p style="color: #4a4a4a; line-height: 1.55; margin: 0 0 24px;">
    Arrivee estimee entre le
    <strong><%= l(window.first, format: "%-d %B") rescue window.first.to_s %></strong>
    et le
    <strong><%= l(window.last, format: "%-d %B %Y") rescue window.last.to_s %></strong>.
    <%= t("mailer.first_scan") %>
  </p>

  <p style="color: #6b6b6b; font-size: 13px; line-height: 1.6; margin: 0;">
    Une question ? Repondez a ce courriel<% if @store.support_email.present? %>
    <%= t("mailer.or_write", email: @store.support_email) %><% end %>.
  </p>
</div>
