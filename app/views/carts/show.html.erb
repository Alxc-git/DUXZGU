<% content_for :title, "Cart | #{current_store.name}" %>

<div class="page stack" style="padding-top:var(--section-gap)">
  <%= render "checkouts/steps", current: 0 %>

  <div class="checkout">
    <div class="stack">
      <div class="card checkout__section">
        <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">Cart</p>
        <h1 style="font-size:var(--fs-display-3)">Your cart</h1>
      </div>

      <% if current_cart.empty? %>
        <div class="card checkout__section">
          <p class="sub">Your cart is empty.</p>
          <div class="actions actions--start"><%= link_to "Back to product", product_page_path, class: "btn btn--primary" %></div>
        </div>
      <% else %>
        <% current_cart.lines.each do |line| %>
          <div class="card checkout__section">
            <div class="checkout__item">
              <span class="checkout__thumb">
                <%= image_tag((@flavor || Flavor.default).packshot, alt: "") %>
              </span>
              <div style="min-width:0;flex:1">
                <div class="stat__label"><%= line.product.display_name %></div>
                <div class="stat__note"><%= line.variant.display_name %></div>
                <div style="font-family:var(--font-display);color:var(--accent);font-size:1.25rem;margin-top:10px">
                  <%= line.formatted_total %>
                </div>
              </div>
            </div>

            <div class="cart-line__controls">
              <%= form_with url: cart_line_path(line.variant.id), method: :patch, class: "cart-line__qty" do |form| %>
                <%= form.number_field :quantity, value: line.quantity, min: 1, max: Cart::MAX_QUANTITY, class: "input" %>
                <%= form.submit "Update", class: "btn btn--secondary" %>
              <% end %>
              <%= button_to "Remove", cart_line_path(line.variant.id), method: :delete, class: "btn btn--ghost" %>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if current_cart.any? %>
        <%= render "shared/cross_sell" %>
      <% end %>
    </div>

    <% if current_cart.any? %>
      <div class="stack checkout__aside">
        <%= render "checkouts/summary", flavor: @flavor || Flavor.default, qty: current_cart.count %>
        <%= link_to "Continue to checkout", checkout_path, class: "btn btn--primary btn--lg btn--full" %>
      </div>
    <% end %>
  </div>
</div>
