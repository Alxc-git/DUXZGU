<% content_for :title, "Cart | #{current_store.name}" %>

<div class="page cart-page">
  <%= render "checkouts/steps", current: 0 %>

  <div class="cart-layout">
    <main class="cart-layout__main">
      <%# A bare heading rather than a card: an empty box the height of a panel
          just to carry two words was the widest thing on the page. %>
      <%= render "shared/page_head",
            title: "Your cart",
            sub: pluralize(current_cart.count, "item"),
            aside: link_to(product_page_path, class: "page-head__back") {
              safe_join([ cj_icon("chevron-left"), "Continue shopping" ])
            } %>

      <% if current_cart.empty? %>
        <div class="card card--pad-lg cart-empty">
          <span class="feature-icon feature-icon--lg"><%= cj_icon "shopping-cart" %></span>
          <h2 style="font-size:var(--fs-title)">Your cart is empty</h2>
          <p class="sub">Nothing here yet. Pick a flavor and it will show up on this page.</p>
          <div class="actions actions--start">
            <%= link_to "Shop Creatine Jelly", product_page_path, class: "btn btn--primary btn--lg" %>
          </div>
        </div>
      <% else %>
        <% current_cart.lines.each do |line| %>
          <article class="card cart-line">
            <div class="checkout__item cart-line__main">
              <span class="checkout__thumb cart-line__media">
                <%= image_tag line.flavor.checkout_image, alt: "" %>
              </span>
              <div class="cart-line__body">
                <div class="stat__label cart-line__name"><%= line.product.display_name %></div>
                <div class="stat__note"><%= line.flavor.name %> &middot; <%= line.variant.display_name %></div>
                <div class="cart-line__price"><%= line.formatted_total %></div>
              </div>
            </div>

            <div class="cart-line__controls">
              <%= form_with url: cart_line_path(line.key), method: :patch, class: "cart-line__qty" do |form| %>
                <%= form.number_field :quantity, value: line.quantity, min: 1, max: Cart::MAX_QUANTITY,
                      class: "input", aria: { label: "Quantity for #{line.flavor.name}" } %>
                <%= form.submit "Update", class: "btn btn--secondary" %>
              <% end %>
              <%= button_to "Remove", cart_line_path(line.key), method: :delete,
                    class: "btn btn--ghost", form: { class: "cart-line__remove" } %>
            </div>
          </article>
        <% end %>
      <% end %>

      <% if current_cart.any? %>
        <%= render "shared/cross_sell" %>
        <%= render "checkouts/reassurance", section: :trust %>
      <% end %>
    </main>

    <% if current_cart.any? %>
      <aside class="cart-layout__aside">
        <%= render layout: "checkouts/summary",
              locals: { flavor: @flavor || Flavor.default, qty: current_cart.count,
                        recap: false, extras: false } do %>
          <%= link_to "Continue to checkout", checkout_path, class: "btn btn--primary btn--lg btn--full",
                style: "margin-top:var(--space-2)" %>
        <% end %>
        <%= render "checkouts/reassurance", section: :support %>
      </aside>
    <% end %>
  </div>
</div>
