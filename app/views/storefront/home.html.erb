<% content_for :title, [ current_store.name, @product&.display_name ].compact_blank.join(" | ") %>
<% content_for :description, @product&.description %>

<% if @product.present? %>
  <%= render "storefront/sections/hero", product: @product %>
  <%= render "storefront/sections/highlights", product: @product %>
  <%= render "storefront/sections/colours", product: @product, heading: t("product.all_colours_heading"), id: "options" %>
  <%= render "storefront/sections/trust", product: @product %>
  <%= render "storefront/sections/craft", product: @product, variant: :fabrication %>
  <%= render "storefront/sections/reviews", product: @product %>
  <%= render "storefront/sections/faq", product: @product %>
  <%= render "storefront/sections/footer_cta", product: @product %>
<% else %>
  <section class="empty-state page-container">
    <h1>Boutique en preparation</h1>
    <p>Aucun produit n'est encore publie sur <%= current_store.name %>.</p>
  </section>
<% end %>
