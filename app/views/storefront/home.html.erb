<% if @product.blank? %>
  <div class="page stack" style="padding-top:var(--space-10);max-width:720px">
    <div class="card card--accent" style="text-align:center">
      <p class="eyebrow eyebrow--accent">Storefront</p>
      <h1 style="font-size:var(--fs-display-3)">No active product</h1>
      <p class="sub">Add or activate a product in the admin to connect the storefront purchase flow.</p>
      <%= link_to "Open admin", admin_root_path, class: "btn btn--primary" %>
    </div>
  </div>
<% else %>
<div class="stack" style="padding-top:var(--section-gap)">
  <div class="page"><%= render "pages/hero", flavor: @flavor %></div>

  <div class="page stack">
    <div class="card"><%= render "shared/stat_row", stats: Storefront::CLAIMS %></div>

    <div class="card card--flush band">
      <div class="band__media">
        <%= image_tag "product/duwzgu-athlete.png", alt: "Athlete with Creatine Jelly", class: "band__image" %>
        <span class="band__scrim"></span>
      </div>
      <div class="band__body">
        <p class="eyebrow eyebrow--accent">Performance. Strength. Results.</p>
        <h2>Creatine you'll<br>actually keep taking.</h2>
        <p class="sub">Saturation is the whole game, and saturation comes from consistency. Four gummies beat a scoop you skip.</p>
        <%= render "shared/compare", tone: "yes", items: ["5000 mg per daily serving", "No shaker, no clumps, no chalk", "Take it anywhere — gym bag, desk, car"] %>
        <div class="actions actions--start"><%= link_to "See the product", product_page_path, class: "btn btn--outline" %></div>
      </div>
    </div>

    <%= render "shared/versus", flavor: @flavor %>

    <div id="flavors" class="card card--pad-lg">
      <div class="section-head section-head--center">
        <p class="eyebrow eyebrow--accent">Three flavors</p>
        <h2>Choose your flavor</h2>
        <p class="sub">Three jars. Same 5000 mg dose. Pick the one you'll look forward to.</p>
      </div>
      <div class="g3">
        <% Flavor::ALL.each do |flavor| %>
          <%= render "shared/flavor_card", flavor: flavor, selected: flavor.slug == @flavor.slug %>
        <% end %>
      </div>
    </div>

    <div class="card card--pad-lg">
      <div class="section-head section-head--center">
        <p class="eyebrow eyebrow--accent">Three steps</p>
        <h2>How to use</h2>
        <p class="sub">No shaker, no scoop, no timing rules. Just take them.</p>
      </div>
      <div class="g3">
        <% Storefront::HOW_TO_USE.each do |step| %>
          <div class="how-step">
            <span class="feature-icon feature-icon--solid feature-icon--sm how-step__n"><%= step[:n] %></span>
            <span class="feature-icon"><%= cj_icon step[:icon] %></span>
            <div>
              <div class="stat__label"><%= step[:title] %></div>
              <div class="stat__note"><%= step[:note] %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="g2">
      <div class="card proof">
        <div class="proof__score">
          <p class="eyebrow eyebrow--accent">Verified reviews</p>
          <div class="proof__number"><%= Storefront::RATING %>/5</div>
          <p class="eyebrow eyebrow--muted">From <%= Storefront::REVIEW_COUNT %> reviews</p>
        </div>

        <hr class="rule">

        <div class="proof__block">
          <div class="stat">
            <span class="feature-icon feature-icon--lg"><%= cj_icon "users" %></span>
            <div style="min-width:0">
              <div class="stat__label">Loved by athletes</div>
              <div class="stat__note">Trusted by <%= Storefront::CUSTOMER_COUNT %> customers worldwide</div>
            </div>
          </div>
          <%= cj_stars Storefront::RATING, size: :lg %>
        </div>

        <hr class="rule">

        <% quote = Storefront::REVIEWS.first %>
        <figure class="proof__quote">
          <blockquote>&ldquo;<%= quote[:quote] %>&rdquo;</blockquote>
          <figcaption>
            <span class="proof__avatar" aria-hidden="true"><%= quote[:name].to_s.strip.first %></span>
            <span>
              <b><%= quote[:name] %></b>
              <span class="testimonial__verified"><%= cj_icon "circle-check" %>Verified buyer</span>
            </span>
          </figcaption>
        </figure>

        <hr class="rule">

        <%= render "shared/trust_row" %>
      </div>

      <div id="flavor-lineup" class="card card--flush image-card image-card--lineup">
        <%= image_tag "product/duwzgu-lineup.png", alt: "Creatine Jelly flavor lineup", class: "image-card__image" %>
        <span class="image-card__scrim"></span>
        <div class="image-card__body">
          <p class="eyebrow eyebrow--accent">Three flavors</p>
          <h2 style="font-size:var(--fs-title)">Real results.<br>Real people.</h2>
        </div>
      </div>
    </div>

    <div class="card card--pad-lg">
      <div class="section-head">
        <p class="eyebrow eyebrow--accent">Verified reviews</p>
        <h2>What athletes say</h2>
      </div>
      <div class="g3">
        <% Storefront::REVIEWS.each do |review| %>
          <%= render "shared/testimonial", review: review %>
        <% end %>
      </div>
    </div>

    <div class="card card--pad-lg">
      <div class="section-head section-head--center">
        <p class="eyebrow eyebrow--accent">FAQ</p>
        <h2>Questions? We've got answers.</h2>
      </div>
      <div style="max-width:860px;margin-inline:auto">
        <%= render "shared/accordion", items: Storefront::FAQ, open_first: true %>
      </div>
    </div>

    <%= render "shared/cta_band", flavor: @flavor %>
  </div>
</div>
<% end %>
