<% if @product.blank? %>
  <div class="page stack" style="padding-top:var(--space-10);max-width:720px">
    <h1>No active product</h1><%= link_to "Open admin", admin_root_path, class: "btn btn--primary" %>
  </div>
<% else %>
  <%= render "shared/product_schema", product: @product %>
  <main class="premium-home">
    <div class="page"><%= render "pages/hero", flavor: @flavor %></div>
    <div class="page"><%= render "shared/product_facts" %></div>
    <section class="page editorial-section" id="flavors">
      <div class="editorial-heading">
        <div><p class="eyebrow"><%= t("premium.flavors.eyebrow") %></p><h2><%= t("premium.flavors.title") %></h2></div>
        <p class="sub"><%= t("premium.flavors.lede") %></p>
      </div>
      <div class="g3 flavor-collection">
        <% Flavor::ALL.each do |flavor| %><%= render "shared/flavor_card", flavor: flavor, selected: flavor.slug == @flavor.slug %><% end %>
      </div>
    </section>
    <%= render "shared/product_editorial" %>
    <section class="page editorial-section" id="routine">
      <div class="editorial-heading">
        <div><p class="eyebrow"><%= t("premium.routine.eyebrow") %></p><h2><%= t("premium.routine.title") %></h2></div>
        <p class="sub"><%= t("premium.routine.lede") %></p>
      </div>
      <ol class="ritual-steps">
        <% %w[one two three].each_with_index do |step, index| %>
          <li><span class="ritual-steps__number">0<%= index + 1 %></span><h3><%= t("premium.routine.#{step}_title") %></h3><p><%= t("premium.routine.#{step}_body") %></p></li>
        <% end %>
      </ol>
    </section>
    <div class="page editorial-section"><%= render "shared/brand_promise" %></div>
    <section class="page editorial-section editorial-faq" id="faq">
      <div class="editorial-heading"><div><p class="eyebrow"><%= t("store.home.faq_eyebrow") %></p><h2><%= t("premium.faq_title") %></h2></div><%= link_to t("store.footer.contact"), contact_path, class: "text-link" %></div>
      <%= render "shared/accordion", items: Storefront.faq, open_first: true %>
    </section>
    <div class="page editorial-section"><%= render "shared/cta_band", flavor: @flavor %></div>
  </main>
<% end %>
