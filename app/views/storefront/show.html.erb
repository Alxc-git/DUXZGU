<%= render "shared/product_schema", product: @product, variant: @variant %>
<div class="page stack stack--lg" style="padding-top:var(--space-4)">
  <div class="pdp" style="--pdp-focus:<%= @flavor.pdp_focus %>">
    <div class="pdp__gallery">
      <div class="pdp__main">
        <%= storefront_image_tag @flavor.pdp_image, alt: "#{@flavor.name} Creatine Jelly", loading: "eager", fetchpriority: "high", sizes: "(min-width: 960px) 50vw, 100vw" %>
        <%= link_to asset_path(@flavor.pdp_image), class: "icon-btn icon-btn--bare", target: "_blank", rel: "noopener", aria: { label: t("store.pdp.zoom") } do %><%= cj_icon "search" %><% end %>
      </div>

      <div class="pdp__thumbs">
        <%# Declaration order, always: a picker that reshuffles under the cursor
            makes the next click land on something else. %>
        <% Flavor::ALL.each do |flavor| %>
          <%= link_to product_page_path(flavor: flavor.slug, plan: @plan, qty: @qty),
                class: ["pdp__thumb", ("is-selected" if flavor.slug == @flavor.slug)],
                style: "--flavor:#{flavor.color_var};--thumb-focus:#{flavor.pdp_focus}" do %>
            <span class="flavor__bg" style="background:<%= flavor.spot_var %>;opacity:.45"></span>
            <%= storefront_image_tag flavor.pdp_image, alt: "", sizes: "(min-width: 960px) 17vw, (min-width: 620px) 30vw, 60vw" %>
            <span style="position:relative;z-index:1">
              <span class="flavor__name" style="font-size:.9375rem"><%= flavor.name %></span>
              <span class="flavor__note" style="display:block;margin-bottom:0"><%= flavor.note %></span>
            </span>
            <% if flavor.slug == @flavor.slug %>
              <span class="flavor__check"><%= cj_icon "check" %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="pdp__buy">
      <div class="pdp__buy-inner">
      <span class="badge badge--outline"><%= t("store.pdp.badge") %></span>
      <h1 class="pdp__title"><%= @product.display_name %></h1>
      <%= cj_stars Storefront::RATING, meta: t("store.hero.reviews_meta", rating: Storefront::RATING, count: Storefront::REVIEW_COUNT) %>

      <% priced_item = @variant || @product %>
      <div>
        <span class="price__row">
          <% if priced_item.discount_percentage.present? %>
            <s class="price__was"><%= priced_item.formatted_compare_at_price %></s>
          <% end %>
          <span class="price__now"><%= priced_item.formatted_price %></span>
          <% if priced_item.discount_percentage.present? %>
            <span class="badge badge--save price__sale">-<%= priced_item.discount_percentage %>%</span>
          <% end %>
        </span>
        <div class="price__note"><%= t("store.pdp.secure_note") %></div>
      </div>

      <p><%= t("store.pdp.description_html").html_safe %></p>

      <div>
        <p class="eyebrow eyebrow--muted" style="margin-bottom:8px"><%= t("store.pdp.choose_flavor") %></p>
        <div class="flavor-pills">
          <% Flavor::ALL.each do |flavor| %>
            <%= render "shared/flavor_pill", flavor: flavor, selected: flavor.slug == @flavor.slug %>
          <% end %>
        </div>
      </div>

      <% if @tiers.any? %>
        <div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin-bottom:10px">
            <p class="eyebrow eyebrow--muted"><%= t("store.pdp.choose_pack") %></p>
            <span style="margin-left:auto;color:var(--text-muted);font-size:var(--fs-caption)"><%= t("store.pdp.servings") %></span>
          </div>
          <%= render "shared/pack_tiers", tiers: @tiers, qty: @qty, plan: @plan, flavor: @flavor %>
        </div>
      <% end %>


      <div class="actions">
        <% if @variant.present? %>
          <%= button_to cart_lines_path,
                params: { product_id: @product.id, variant_id: @variant.id, quantity: @qty, flavor: @flavor.slug },
                class: "btn btn--primary btn--lg" do %>
            <%= cj_icon "shopping-cart", size: "1.15em" %> <%= t("store.pdp.add_to_cart") %>
          <% end %>
          <%= button_to cart_lines_path,
                params: { product_id: @product.id, variant_id: @variant.id, quantity: @qty, flavor: @flavor.slug, then: "checkout" },
                class: "btn btn--outline btn--lg" do %>
            <%= t("store.pdp.buy_now") %> - <%= @selected_tier&.formatted_total || @variant.formatted_price %>
          <% end %>
        <% end %>
      </div>

      <%# Payment marks and guarantees pair off; the dispatch line spans both, so
          neither column has to stretch to match the other's item count. %>
      <%# Full-width rows rather than two columns: two items on one side and three
          on the other can only be made level by padding one of them out. Each row
          is balanced within itself instead. %>
      <div class="assurance">
        <div class="assurance__row">
          <%= render "shared/payment_methods", size: "sm" %>
          <%= render "shared/dispatch_countdown" %>
        </div>
        <%= render "shared/trust_row" %>
      </div>
      </div>
    </div>
  </div>

  <div class="card card--pad-lg" id="benefits"><%= render "shared/stat_row", stats: Storefront.claims %></div>

  <%= render "shared/versus", flavor: @flavor, rival: t("store.versus.traditional") %>

  <div class="card card--pad-lg">
    <div class="section-head section-head--center">
      <p class="eyebrow eyebrow--accent"><%= t("store.home.steps_eyebrow") %></p>
      <h2><%= t("store.home.steps_title") %></h2>
      <p class="sub"><%= t("store.home.steps_lede") %></p>
    </div>
    <%= render "shared/routine" %>
  </div>

  <div class="card card--pad-lg" id="reviews">
    <div class="section-head section-head--center">
      <p class="eyebrow eyebrow--accent"><%= t("store.home.reviews_eyebrow") %></p>
      <h2><%= t("store.pdp.loved_title") %></h2>
      <p class="sub"><%= t("store.pdp.loved_lede", rating: Storefront::RATING, count: Storefront::REVIEW_COUNT) %></p>
    </div>
    <div class="g3 review-carousel"
         data-review-carousel role="region" tabindex="0"
         aria-label="<%= t("store.pdp.loved_title") %>">
      <% Storefront.reviews.each do |review| %>
        <%= render "shared/testimonial", review: review %>
      <% end %>
    </div>
  </div>

  <div class="card card--pad-lg" id="faq">
    <div class="section-head section-head--center">
      <p class="eyebrow eyebrow--accent"><%= t("store.home.faq_eyebrow") %></p>
      <h2><%= t("store.home.faq_title") %></h2>
    </div>
    <div style="max-width:860px;margin-inline:auto">
      <%= render "shared/accordion", items: Storefront.faq, open_first: true %>
    </div>
  </div>

  <%= render "shared/cta_band", flavor: @flavor, hide_product_link: true %>
</div>
