<% content_for :title, "#{@product.name} | #{current_store.name}" %>
<% content_for :description, @product.description %>

<article class="pdp" data-controller="variant">
  <div class="page-container">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <%= link_to "Accueil", root_path %>
      <%= icon "chevron-right", size: 14 %>
      <span aria-current="page"><%= @product.name %></span>
    </nav>

    <div class="pdp__grid">
      <%= render "storefront/sections/gallery", product: @product, variant: @variant %>
      <%= render "storefront/sections/buy_box", product: @product, variant: @variant %>
    </div>
  </div>

  <%= render "storefront/sections/specs", product: @product %>
  <%= render "storefront/sections/sticky_bar", product: @product, variant: @variant %>
</article>

<%# Comparateur retire de la page produit pour garder un parcours d'achat plus direct. %>
<%= render "storefront/sections/craft", product: @product, variant: :collection %>
<%= render "storefront/sections/reviews", product: @product %>
<%= render "storefront/sections/faq", product: @product %>
<%= render "storefront/sections/footer_cta", product: @product %>
