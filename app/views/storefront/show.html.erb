<%= render "shared/product_schema", product: @product, variant: @variant %>
<main class="page premium-product" style="padding-top:var(--space-8)">
  <div class="pdp" data-flavor-theme style="--active-flavor:<%= @flavor.color_var %>;--active-spot:<%= @flavor.spot_var %>">
    <div class="pdp__gallery">
      <div class="pdp__main">
        <%= storefront_image_tag @flavor.card_image, alt: "#{@flavor.name} · DUWZGU Creatine Jelly", loading: "eager", fetchpriority: "high", sizes: "(min-width: 960px) 50vw, 100vw", data: { flavor_image: true } %>
        <%= link_to asset_path(@flavor.card_image), class: "icon-btn icon-btn--bare", target: "_blank", rel: "noopener", aria: { label: t("store.pdp.zoom") }, data: { flavor_zoom: true } do %><%= cj_icon "search" %><% end %>
      </div>
      <div class="pdp__thumbs">
        <% Flavor::ALL.each do |flavor| %>
          <%= link_to product_page_path(flavor: flavor.slug, plan: @plan, qty: @qty),
                class: ["pdp__thumb", ("is-selected" if flavor.slug == @flavor.slug)], data: flavor_choice_data(flavor),
                aria: { current: ("true" if flavor.slug == @flavor.slug) }, style: "--flavor:#{flavor.color_var}" do %>
            <%= storefront_image_tag flavor.card_image, alt: "", sizes: "(min-width: 960px) 16vw, 30vw" %>
            <span class="flavor__name"><%= flavor.name %></span>
            <span class="flavor__check" data-flavor-check <%= 'hidden' unless flavor.slug == @flavor.slug %>><%= cj_icon "check" %></span>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="pdp__buy">
      <div class="pdp__buy-inner">
        <p class="eyebrow">DUWZGU / <span data-flavor-text="name"><%= @flavor.name %></span></p>
        <h1 class="pdp__title"><%= @product.display_name %></h1>
        <p class="pdp__identity"><%= t("premium.product.identity") %></p>
        <% priced_item = @variant || @product %>
        <div>
          <span class="price__row">
            <% if priced_item.discount_percentage.present? %><s class="price__was"><%= priced_item.formatted_compare_at_price %></s><% end %>
            <span class="price__now"><%= priced_item.formatted_price %></span>
            <% if priced_item.discount_percentage.present? %><span class="badge badge--save price__sale">-<%= priced_item.discount_percentage %>%</span><% end %>
          </span>
          <div class="price__note"><%= t("store.pdp.secure_note") %></div>
        </div>
        <p class="sub"><%= t("premium.hero.lede") %></p>
        <div>
          <p class="eyebrow eyebrow--muted" style="margin-bottom:10px"><%= t("store.pdp.choose_flavor") %></p>
          <div class="flavor-pills"><% Flavor::ALL.each do |flavor| %><%= render "shared/flavor_pill", flavor: flavor, selected: flavor.slug == @flavor.slug %><% end %></div>
        </div>
        <% if @tiers.any? %>
          <div><p class="eyebrow eyebrow--muted" style="margin-bottom:12px"><%= t("store.pdp.choose_pack") %></p><%= render "shared/pack_tiers", tiers: @tiers, qty: @qty, plan: @plan, flavor: @flavor %></div>
        <% end %>
        <div class="actions" data-purchase-actions>
          <% if @variant.present? %>
            <%= button_to cart_lines_path, params: { product_id: @product.id, variant_id: @variant.id, quantity: @qty, flavor: @flavor.slug }, form: { data: { flavor_purchase: true } }, class: "btn btn--primary btn--lg" do %>
              <%= cj_icon "shopping-cart" %><%= t("store.pdp.add_to_cart") %>
            <% end %>
            <%= button_to cart_lines_path, params: { product_id: @product.id, variant_id: @variant.id, quantity: @qty, flavor: @flavor.slug, then: "checkout" }, form: { data: { flavor_purchase: true } }, class: "btn btn--outline btn--lg" do %>
              <%= t("store.pdp.buy_now") %> - <%= @selected_tier&.formatted_total || @variant.formatted_price %>
            <% end %>
          <% end %>
        </div>
        <div class="assurance">
          <div class="assurance__row"><%= render "shared/payment_methods", size: "sm" %><%= render "shared/dispatch_countdown" %></div>
          <%= render "shared/trust_row" %>
        </div>
      </div>
    </div>
  </div>
  <section class="editorial-section" id="benefits">
    <div class="editorial-heading"><div><p class="eyebrow">CREATINE JELLY</p><h2><%= t("premium.product.details") %></h2></div><p class="sub"><%= t("premium.product.note") %></p></div>
    <%= render "shared/product_facts" %>
  </section>
  <div class="editorial-section"><%= render "shared/brand_promise" %></div>
  <section class="editorial-section editorial-faq" id="faq">
    <div class="editorial-heading"><div><p class="eyebrow"><%= t("store.home.faq_eyebrow") %></p><h2><%= t("premium.faq_title") %></h2></div><%= link_to t("store.footer.contact"), contact_path, class: "text-link" %></div>
    <%= render "shared/accordion", items: Storefront.faq, open_first: true %>
  </section>
  <div class="editorial-section"><%= render "shared/cta_band", flavor: @flavor, hide_product_link: true %></div>
</main>
