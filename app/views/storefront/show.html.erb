<%= render "shared/product_schema", product: @product, variant: @variant %>
<div class="page stack stack--lg" style="padding-top:var(--space-4)">
  <div class="pdp" style="--pdp-focus:<%= @flavor.pdp_focus %>">
    <div class="pdp__gallery">
      <div class="pdp__main">
        <%= image_tag @flavor.pdp_image, alt: "#{@flavor.name} Creatine Jelly" %>
        <button type="button" class="icon-btn icon-btn--bare" aria-label="Zoom"><%= cj_icon "search" %></button>
      </div>

      <div class="pdp__thumbs">
        <%# Declaration order, always: a picker that reshuffles under the cursor
            makes the next click land on something else. %>
        <% Flavor::ALL.each do |flavor| %>
          <%= link_to product_page_path(flavor: flavor.slug, plan: @plan, qty: @qty),
                class: ["pdp__thumb", ("is-selected" if flavor.slug == @flavor.slug)],
                style: "--flavor:#{flavor.color_var};--thumb-focus:#{flavor.pdp_focus}" do %>
            <span class="flavor__bg" style="background:<%= flavor.spot_var %>;opacity:.45"></span>
            <%= image_tag flavor.pdp_image, alt: "" %>
            <span style="position:relative;z-index:1">
              <span class="flavor__name" style="font-size:.9375rem"><%= flavor.name %></span>
              <span class="flavor__note" style="display:block;margin-bottom:0"><%= flavor.note %></span>
            </span>
            <% if flavor.slug == @flavor.slug %>
              <span class="flavor__check"><%= cj_icon "check" %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="pdp__buy">
      <div class="pdp__buy-inner">
      <span class="badge badge--outline">Premium creatine gummies</span>
      <h1 class="pdp__title"><%= @product.display_name %></h1>
      <%= cj_stars Storefront::RATING, meta: "#{Storefront::RATING}/5 (#{Storefront::REVIEW_COUNT} reviews)" %>

      <div>
        <span class="price__row">
          <% if @plan == "sub" %><s class="price__was"><%= Storefront::PRICE %></s><% end %>
          <span class="price__now"><%= @variant&.formatted_price || @product.formatted_price %></span>
        </span>
        <div class="price__note">Secure checkout with Stripe or PayPal</div>
      </div>

      <p><b style="color:var(--white)">Delicious daily creatine gummies</b> for strength, power and recovery. No mixing, no mess.</p>

      <div>
        <p class="eyebrow eyebrow--muted" style="margin-bottom:8px">Choose your flavor</p>
        <div class="flavor-pills">
          <% Flavor::ALL.each do |flavor| %>
            <%= render "shared/flavor_pill", flavor: flavor, selected: flavor.slug == @flavor.slug %>
          <% end %>
        </div>
      </div>

      <% if @tiers.any? %>
        <div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin-bottom:10px">
            <p class="eyebrow eyebrow--muted">Choose your pack</p>
            <span style="margin-left:auto;color:var(--text-muted);font-size:var(--fs-caption)">130 gummies &middot; 32 servings per jar</span>
          </div>
          <%= render "shared/pack_tiers", tiers: @tiers, qty: @qty, plan: @plan, flavor: @flavor %>
        </div>
      <% end %>

      <div style="display:flex;flex-direction:column;gap:10px">
        <%= render "shared/option", title: "One-time purchase", price: @variant&.formatted_price || @product.formatted_price,
              selected: @plan == "once", href: product_page_path(flavor: @flavor.slug, plan: "once", qty: @qty) %>
        <%= render "shared/option", title: "Subscribe & save 15%", note: "Cancel anytime",
              price: Storefront::PRICE_SUB, selected: @plan == "sub",
              href: product_page_path(flavor: @flavor.slug, plan: "sub", qty: @qty) %>
      </div>

      <div class="actions">
        <% if @variant.present? %>
          <%= button_to cart_lines_path,
                params: { product_id: @product.id, variant_id: @variant.id, quantity: @qty, flavor: @flavor.slug },
                class: "btn btn--primary btn--lg" do %>
            <%= cj_icon "shopping-cart", size: "1.15em" %> Add to cart
          <% end %>
          <%= button_to cart_lines_path,
                params: { product_id: @product.id, variant_id: @variant.id, quantity: @qty, flavor: @flavor.slug, then: "checkout" },
                class: "btn btn--outline btn--lg" do %>
            Buy now - <%= @selected_tier&.formatted_total || @variant.formatted_price %>
          <% end %>
        <% end %>
      </div>

      <div class="assurance">
        <div class="assurance__col">
          <%= render "shared/payment_methods", size: "sm" %>
          <%= render "shared/dispatch_countdown" %>
        </div>
        <%= render "shared/trust_row", variant: "stack" %>
      </div>
      </div>
    </div>
  </div>

  <div class="card card--pad-lg" id="benefits"><%= render "shared/stat_row", stats: Storefront::CLAIMS %></div>

  <%= render "shared/versus", flavor: @flavor, rival: "Traditional powder" %>

  <div class="card card--pad-lg">
    <div class="section-head section-head--center">
      <p class="eyebrow eyebrow--accent">Three steps</p>
      <h2>How to use</h2>
      <p class="sub">No shaker, no scoop, no timing rules. Just take them.</p>
    </div>
    <div class="g3">
      <% Storefront::HOW_TO_USE.each do |step| %>
        <div class="how-step">
          <span class="feature-icon feature-icon--solid feature-icon--sm how-step__n"><%= step[:n] %></span>
          <span class="feature-icon"><%= cj_icon step[:icon] %></span>
          <div>
            <div class="stat__label"><%= step[:title] %></div>
            <div class="stat__note"><%= step[:note] %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card card--pad-lg" id="reviews">
    <div class="section-head section-head--center">
      <p class="eyebrow eyebrow--accent">Verified reviews</p>
      <h2>Loved by athletes</h2>
      <p class="sub"><%= Storefront::RATING %>/5 from <%= Storefront::REVIEW_COUNT %> reviews.</p>
    </div>
    <div class="g3">
      <% Storefront::REVIEWS.each do |review| %>
        <%= render "shared/testimonial", review: review %>
      <% end %>
    </div>
  </div>

  <div class="card card--pad-lg" id="faq">
    <div class="section-head section-head--center">
      <p class="eyebrow eyebrow--accent">FAQ</p>
      <h2>Questions? We've got answers.</h2>
    </div>
    <div style="max-width:860px;margin-inline:auto">
      <%= render "shared/accordion", items: Storefront::FAQ, open_first: true %>
    </div>
  </div>

  <%= render "shared/cta_band", flavor: @flavor, hide_product_link: true %>
</div>
