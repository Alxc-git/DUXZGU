<% content_for :title, "Paiement annule | #{current_store.name}" %>
<section class="checkout-status">
  <div class="page-container checkout-status__inner">
    <span class="checkout-status__icon"><%= icon "refresh", size: 32 %></span>
    <h1 class="checkout-status__title">Paiement annule</h1>
    <p class="checkout-status__body">Aucun montant n'a ete debite. Votre selection vous attend toujours.</p>
    <%= link_to "Revenir au produit", current_product ? storefront_product_path(current_product.slug) : root_path, class: "button button--lg" %>
  </div>
</section>
