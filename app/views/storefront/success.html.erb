<% content_for :hide_buy_bar, true %>

<div class="page stack" style="padding-top:var(--space-10);max-width:760px">
  <%= render "checkouts/steps", current: 2 %>

  <div class="card card--accent" style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:var(--space-5);padding:var(--space-12) var(--space-6)">
    <span class="feature-icon feature-icon--lg feature-icon--solid"><%= cj_icon(@awaiting_payment ? "clock" : "check") %></span>
    <h1 style="font-size:var(--fs-display-3)"><%= @awaiting_payment ? "Order recorded" : "Order confirmed" %></h1>

    <% if @orders.any? %>
      <div class="stack" style="width:100%;text-align:left">
        <% @orders.each do |order| %>
          <div class="checkout__line">
            <span>
              <b><%= order.line_item_name %></b><br>
              <small><%= order.metadata["checkout_reference"] || "ORD-#{order.id}" %> · <%= order.status %></small>
            </span>
            <b><%= order.formatted_total %></b>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="sub">No order is attached to this browser session.</p>
    <% end %>

    <%= link_to "Back to store", root_path, class: "btn btn--primary" %>
  </div>
</div>
