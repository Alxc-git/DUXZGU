<section class="specs" id="specifications">
  <div class="page-container specs__grid">
    <div class="specs__panel specs__features">
      <h2 class="section-heading section-heading--sm"><%= t("sections.why_this_watch") %></h2>
      <ul class="specs__feature-list">
        <% product.content["features"].each do |feature| %>
          <li>
            <span class="feature__icon"><%= icon feature["icon"], size: 22 %></span>
            <div>
              <h3 class="feature__title"><%= feature["title"] %></h3>
              <p class="feature__body"><%= feature["body"] %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="specs__panel specs__table">
      <h2 class="section-heading section-heading--sm"><%= t("sections.specifications") %></h2>
      <dl class="spec-list">
        <% product.content["specs"].each do |spec| %>
          <div class="spec-list__row">
            <dt><%= icon spec["icon"], size: 18 %><span><%= spec["label"] %></span></dt>
            <dd><%= spec["value"] %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</section>
