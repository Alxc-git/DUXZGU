<% featured = current_product %>
<% product_path = featured.present? ? storefront_product_path(featured.slug) : root_path %>

<%# Announcement bar disabled temporarily for visual comparison. %>
<% if false %>
<div class="announce">
  <div class="page-container announce__inner">
    <span class="announce__item announce__item--primary">
      <%= icon "truck", size: 15 %>
      <span>Livraison suivie <%= current_store&.free_shipping? ? "offerte" : "24/48h" %></span>
    </span>
    <span class="announce__item">
      <%= icon "shield-check", size: 15 %>
      <span>Garantie 2 ans</span>
    </span>
    <span class="announce__item">
      <%= icon "refresh", size: 15 %>
      <span>Retour 30 jours</span>
    </span>
  </div>
</div>
<% end %>

<div class="search-scope" data-controller="search">
<header class="site-header"
        data-controller="site-header menu"
        data-menu-open-class="site-header--menu-open"
        data-site-header-stuck-class="site-header--stuck"
        data-site-header-hidden-class="site-header--hidden">
  <%# Wordmark centred, controls balanced either side of it: the sections live in
      the menu panel rather than as tabs in the bar. %>
  <div class="site-header__bar page-container">
    <div class="site-header__side">
      <button type="button"
              class="site-header__control"
              data-action="menu#toggle"
              aria-expanded="false"
              aria-controls="menu-panel">
        <span class="site-header__control-icon" data-menu-target="openIcon"><%= icon "menu", size: 19 %></span>
        <span class="site-header__control-icon" data-menu-target="closeIcon" hidden><%= icon "close", size: 19 %></span>
        <span class="site-header__control-label">Menu</span>
      </button>

      <% if featured.present? %>
        <%# Hidden on phones, where it would unbalance the bar: the menu panel
            carries the search entry there instead. %>
        <button type="button" class="site-header__control site-header__control--search" data-action="search#open">
          <span class="site-header__control-icon"><%= icon "search", size: 19 %></span>
          <span class="site-header__control-label">Rechercher</span>
        </button>
      <% end %>
    </div>

    <%= link_to "LUXTIME", root_path, class: "site-header__brand", aria: { label: "#{current_store&.name} accueil" } %>

    <div class="site-header__side site-header__side--end">
      <%= link_to cart_path, class: "site-header__control site-header__cart",
            aria: { label: "Voir le panier" } do %>
        <span class="site-header__control-icon">
          <%= icon "bag", size: 19 %>
          <% if current_cart.any? %>
            <span class="site-header__cart-count"><%= current_cart.count %></span>
          <% end %>
        </span>
        <span class="site-header__control-label">Panier</span>
      <% end %>

      <% if featured.present? %>
        <%= link_to "Acheter", "#{product_path}#formulaire-achat", class: "site-header__buy" %>
      <% end %>
    </div>
  </div>

  <div class="site-header__drawer" id="menu-panel" data-menu-target="panel">
    <%# Four real destinations. The section anchors that used to sit here all led
        back to the same page, so the product itself fills the panel instead. %>
    <nav class="site-header__drawer-nav" aria-label="Menu">
      <% if featured.present? %>
        <button type="button" class="site-header__drawer-search" data-action="menu#close search#open">
          <span>Rechercher</span>
          <%= icon "search", size: 18 %>
        </button>
      <% end %>
      <%= link_to root_path, data: { action: "menu#close" } do %>
        <span>Accueil</span>
        <%= icon "chevron-right", size: 18 %>
      <% end %>
      <% if featured.present? %>
        <%= link_to product_path, data: { action: "menu#close" } do %>
          <span>La montre</span>
          <%= icon "chevron-right", size: 18 %>
        <% end %>
      <% end %>
      <%= link_to contact_path, data: { action: "menu#close" } do %>
        <span>Contact</span>
        <%= icon "chevron-right", size: 18 %>
      <% end %>
      <%= link_to cart_path, data: { action: "menu#close" } do %>
        <span>Panier<%= " (#{current_cart.count})" if current_cart.any? %></span>
        <%= icon "chevron-right", size: 18 %>
      <% end %>
    </nav>

    <% if featured.present? %>
      <%= link_to product_path, class: "drawer-product", data: { action: "menu#close" } do %>
        <span class="drawer-product__media">
          <%= variant_image_tag featured.default_variant, alt: featured.name, thumb: 130, loading: "lazy" %>
        </span>
        <span class="drawer-product__body">
          <span class="drawer-product__eyebrow">Notre modele</span>
          <strong class="drawer-product__name"><%= featured.name %></strong>
          <span class="drawer-product__rating">
            <%= star_rating featured.rating, size: 13 %>
            <span><%= number_with_precision(featured.rating, precision: 1, separator: ",") %> &middot; <%= featured.reviews_count %> avis</span>
          </span>
          <span class="drawer-product__price">
            <strong><%= featured.formatted_price %></strong>
            <% if featured.formatted_compare_at_price.present? %>
              <s><%= featured.formatted_compare_at_price %></s>
            <% end %>
          </span>
        </span>
      <% end %>
    <% end %>

    <div class="site-header__drawer-foot">
      <% if featured.present? %>
        <%= link_to "Acheter maintenant", "#{product_path}#formulaire-achat",
              class: "button button--lg button--block", data: { action: "menu#close" } %>
      <% end %>
      <div class="payment-note">
        <span class="payment-note__label">
          <%= icon "lock", size: 15 %>
          <span>Paiement securise</span>
        </span>
        <%= payment_marks(class: "payment-marks--sm") %>
      </div>
    </div>
  </div>

</header>

<%# Outside the header on purpose: see the comment on .search-scope above. %>
<% if featured.present? %>
  <%= render "storefront/sections/search", product: featured %>
<% end %>
</div>
