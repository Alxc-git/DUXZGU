<%# Only renders for a product that actually has an exploded view attached. %>
<% if product.craft_image.attached? %>
  <section class="craft">
    <div class="page-container craft__grid">
      <div class="craft__media">
        <%= image_tag product.craft_image, alt: "Vue eclatee de #{product.name}",
              class: "craft__image", loading: "lazy", decoding: "async" %>
      </div>

      <div class="craft__content">
        <p class="craft__eyebrow"><span class="hero__rule"></span>Fabrication</p>
        <h2 class="craft__title">Chaque piece a sa raison d'etre</h2>
        <p class="craft__lede">
          Boitier en alliage, verre mineral durci, mouvement quartz chronographe et
          joint d'etancheite : la montre est assemblee piece par piece, puis controlee
          avant expedition.
        </p>

        <ul class="craft__list">
          <% product.content["specs"].first(4).each do |spec| %>
            <li>
              <%= icon spec["icon"], size: 18 %>
              <span><strong><%= spec["label"] %></strong><%= spec["value"] %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </section>
<% end %>
