<%# Home and product pages use the same visual section with different editorial angles. %>
<% section_variant = local_assigns.fetch(:variant, :fabrication).to_sym %>
<% if section_variant == :collection %>
  <% section_image = product.collection_image %>
  <% section_alt = t("craft.collection_alt", product: product.display_name) %>
  <% section_eyebrow = t("craft.collection_eyebrow") %>
  <% section_title = t("craft.collection_heading") %>
  <% section_lede = t("craft.collection_lede") %>
  <% section_points = [
    { icon: "sparkles", label: t("craft.finishes"), value: t("craft.collection_title"),
      body: t("craft.finishes_desc") },
    { icon: "gauge", label: t("craft.dial"), value: t("craft.dial_value"),
      body: t("craft.dial_desc") },
    { icon: "strap", label: t("craft.strap"), value: t("craft.strap_value"),
      body: t("craft.strap_desc") },
    { icon: "shield-check", label: t("craft.trust"), value: t("craft.trust_value"),
      body: t("craft.trust_desc") }
  ] %>
<% else %>
  <% section_image = product.craft_image %>
  <% section_alt = t("craft.detail_alt", product: product.display_name) %>
  <% section_eyebrow = t("craft.eyebrow") %>
  <% section_title = t("craft.title") %>
  <% section_lede = t("craft.lede") %>
  <%# Keyed by icon rather than label: the label is translated, the icon is not. %>
  <% spec_descriptions = {
    "clock" => t("craft.spec_movement"),
    "shield" => t("craft.spec_case"),
    "spark" => t("craft.spec_glass"),
    "drop" => t("craft.spec_water")
  } %>
  <% section_points = product.content["specs"].first(4).map do |spec|
    { icon: spec["icon"], label: spec["label"], value: spec["value"], body: spec_descriptions[spec["icon"]] }
  end %>
<% end %>

<% if section_image.attached? %>
  <section class="craft">
    <div class="page-container craft__grid">
      <div class="craft__media">
        <%# Capped at 540px tall by the stylesheet, so it is served at that size
            rather than as the full exploded-view original. %>
        <%= product_part_image_tag section_image, alt: section_alt, thumb: 560,
              class: "craft__image", loading: "lazy", decoding: "async" %>
      </div>

      <div class="craft__content">
        <p class="craft__eyebrow"><span class="hero__rule"></span><%= section_eyebrow %></p>
        <h2 class="craft__title"><%= section_title %></h2>
        <p class="craft__lede"><%= section_lede %></p>

        <ul class="craft__list">
          <% section_points.each do |point| %>
            <li>
              <%= icon point[:icon], size: 18 %>
              <span>
                <strong><%= point[:label] %></strong>
                <%= point[:value] %>
                <% if point[:body].present? %>
                  <small><%= point[:body] %></small>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </section>
<% end %>
