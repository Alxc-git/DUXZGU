<%# One rail for every photo of the product: the selected option first, then the
    detail shots. The stage, the thumbnails and the dots are three views of the
    same index, so they can never drift apart. %>
<% parts = variant_gallery_details(variant, product) %>
<% packshot_url = variant_image_url(variant) %>

<div class="gallery"
     data-controller="gallery"
     data-gallery-variant-id="<%= variant&.id %>"
     data-gallery-active-class="is-active">

  <div class="gallery__rail">
    <ul class="gallery__thumbs" role="list">
      <li>
        <button type="button"
                class="gallery__thumb is-active"
                data-gallery-target="thumb"
                data-action="gallery#show"
                data-gallery-index-param="0"
                data-gallery-src="<%= packshot_url %>"
                data-gallery-alt="<%= product.display_name %>"
                data-gallery-fit="contain"
                aria-label="<%= t("sections.whole_product") %>">
          <span class="gallery__thumb-media">
            <%= variant_image_tag variant, alt: "#{product.display_name} - #{variant&.display_name}", thumb: 130,
                  data: { variant_target: "image" }, loading: "lazy", decoding: "async" %>
          </span>
        </button>
      </li>

      <% parts.each_with_index do |detail, index| %>
        <% detail_label = detail[:label] %>
        <li>
          <button type="button"
                  class="gallery__thumb"
                  data-gallery-target="thumb"
                  data-action="gallery#show"
                  data-gallery-index-param="<%= index + 1 %>"
                  data-gallery-src="<%= detail[:src] %>"
                  data-gallery-alt="<%= detail[:alt] %>"
                  data-gallery-fit="contain"
                  aria-label="<%= t("sections.see_detail", label: detail_label.downcase) %>">
            <span class="gallery__thumb-media">
              <%= image_tag detail[:src], alt: detail[:alt], loading: "lazy", decoding: "async" %>
            </span>
          </button>
        </li>
      <% end %>
    </ul>
  </div>

  <figure class="gallery__stage">
    <%= variant_image_tag variant, alt: product.display_name, class: "gallery__image", thumb: 620,
          data: { variant_target: "heroImage", gallery_target: "stage" },
          fetchpriority: "high", decoding: "async" %>

    <div class="gallery__tools">
      <button type="button" class="gallery__tool" data-action="gallery#zoom" aria-label="<%= t("sections.zoom_photo") %>">
        <%= icon "zoom", size: 18 %>
      </button>
    </div>

    <% if product.discount_percentage.present? %>
      <figcaption class="tag tag--sale gallery__badge"><%= t("sections.clearance") %> -<%= product.discount_percentage %>%</figcaption>
    <% end %>

    <% if parts.any? %>
      <div class="gallery__dots" role="tablist" aria-label="<%= t("sections.product_photos") %>">
        <% (parts.length + 1).times do |index| %>
          <button type="button"
                  class="gallery__dot <%= "is-active" if index.zero? %>"
                  data-gallery-target="dot"
                  data-action="gallery#show"
                  data-gallery-index-param="<%= index %>"
                  role="tab"
                  aria-selected="<%= index.zero? %>"
                  aria-label="<%= t("sections.photo_n", n: index + 1) %>"></button>
        <% end %>
      </div>
    <% end %>
  </figure>

  <%# Lightbox, so the customer can inspect the dial before buying. %>
  <div class="lightbox" data-gallery-target="lightbox" data-action="click->gallery#closeZoom" hidden>
    <button type="button" class="lightbox__close" aria-label="<%= t("common.close") %>">
      <%= icon "close", size: 20 %>
    </button>
    <img class="lightbox__image"
         data-gallery-target="lightboxImage"
         src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
         alt="">
  </div>
</div>
