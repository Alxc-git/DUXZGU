<% featured = current_product %>
<div class="support-chat"
     data-controller="support-chat"
     data-support-chat-url-value="<%= support_chat_path %>"
     data-support-chat-open-class="is-open">
  <button type="button"
          class="support-chat__toggle"
          data-support-chat-target="toggle"
          data-action="support-chat#toggle"
          aria-expanded="false"
          aria-label="Ouvrir l'assistant">
    <span class="support-chat__toggle-icon"><%= icon "sparkles", size: 22 %></span>
    <%# Sits above the button so a waiting reply is visible without opening it. %>
    <span class="support-chat__badge" data-support-chat-target="badge" aria-hidden="true">1</span>
  </button>

  <section class="support-chat__panel" data-support-chat-target="panel"
           role="dialog" aria-label="Assistant LUXTIME" hidden>
    <header class="support-chat__head">
      <span class="support-chat__avatar"><%= icon "sparkles", size: 18 %></span>
      <span class="support-chat__identity">
        <strong>Assistant LUXTIME</strong>
        <small><span class="support-chat__pulse"></span>En ligne 24/7</small>
      </span>
      <button type="button" class="support-chat__close" data-action="support-chat#close" aria-label="Fermer">
        <%= icon "close", size: 18 %>
      </button>
    </header>

    <details class="support-chat__tracker">
      <summary>
        <span class="support-chat__tracker-icon"><%= icon "package", size: 17 %></span>
        <span>
          <strong>Suivi commande</strong>
          <small>Reference + courriel d'achat</small>
        </span>
        <%= icon "chevron-down", size: 17, class: "support-chat__tracker-chevron" %>
      </summary>

      <form class="support-chat__tracker-form" data-action="submit->support-chat#trackOrder">
        <label>
          <span>Reference</span>
          <input type="text"
                 data-support-chat-target="trackerReference"
                 placeholder="LX-AB12CD34 ou ORD-123"
                 autocomplete="off">
        </label>
        <label>
          <span>Courriel</span>
          <input type="email"
                 data-support-chat-target="trackerEmail"
                 placeholder="vous@exemple.com"
                 autocomplete="email">
        </label>
        <button type="submit">Verifier</button>
      </form>
    </details>

    <div class="support-chat__messages" data-support-chat-target="messages" role="log" aria-live="polite"></div>

    <%# Three questions that cover most of what support actually receives. %>
    <div class="support-chat__suggestions" data-support-chat-target="suggestions">
      <%# The emoji is decoration on the button; the plain sentence is what gets
          sent, so the assistant reads a clean question. %>
      <% [
        [ "\u{1F4E6}", "Ou en est ma commande ?" ],
        [ "\u{1F3E0}", "Puis-je modifier mon adresse ?" ],
        [ "\u{21A9}\u{FE0F}", "Comment faire un retour ?" ],
        featured.present? ? [ "\u{1F3A8}", "Quelles couleurs sont disponibles ?" ] : nil,
        [ "\u{1F69A}", "Combien de temps pour la livraison ?" ]
      ].compact.each do |emoji, prompt| %>
        <button type="button" class="support-chat__chip"
                data-action="support-chat#useSuggestion"
                data-support-chat-prompt-param="<%= prompt %>">
          <span aria-hidden="true"><%= emoji %></span>
          <%= prompt %>
        </button>
      <% end %>
    </div>

    <form class="support-chat__form" data-support-chat-target="form" data-action="submit->support-chat#submit">
      <label class="support-chat__label" for="support-chat-message">Votre message</label>
      <textarea id="support-chat-message"
                class="support-chat__input"
                data-support-chat-target="input"
                data-action="keydown->support-chat#keydown input->support-chat#grow"
                rows="1"
                maxlength="1000"
                enterkeyhint="send"
                placeholder="Ecrivez votre question..."></textarea>
      <button type="submit" class="support-chat__send" data-support-chat-target="submit" aria-label="Envoyer">
        <%= icon "arrow-right", size: 18 %>
      </button>
    </form>
  </section>
</div>
