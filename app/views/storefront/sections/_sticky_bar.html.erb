<%# Mirrors the buy box once it scrolls out of view; submits the same form. %>
<% priced = variant || product %>
<div class="sticky-bar" data-controller="sticky-bar" data-sticky-bar-visible-class="sticky-bar--visible"
     data-sticky-bar-anchor-value="#formulaire-achat" hidden>
  <div class="page-container sticky-bar__inner">
    <div class="sticky-bar__product">
      <%= variant_image_tag variant, alt: product.display_name, thumb: 80, class: "sticky-bar__image",
            data: { variant_target: "image" }, loading: "lazy" %>
      <div>
        <strong class="sticky-bar__name"><%= product.display_name %></strong>
        <span class="sticky-bar__colour" data-variant-target="name"><%= variant&.display_name %></span>
      </div>
    </div>

    <div class="sticky-bar__cta">
      <%= payment_marks(class: "payment-marks--sm sticky-bar__marks") %>
      <span class="sticky-bar__price" data-variant-target="price"><%= priced.formatted_price %></span>
      <button type="submit" form="formulaire-achat" name="then" value="checkout" class="button button--lg">
        <%= icon "bag", size: 18 %>
        <span><%= t("common.buy") %></span>
      </button>
    </div>
  </div>
</div>
