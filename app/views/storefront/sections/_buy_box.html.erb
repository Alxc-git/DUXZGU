<% priced = variant || product %>
<div class="buy-box">
  <div class="buy-box__head">
    <h1 class="buy-box__title"><%= product.name %></h1>

    <p class="buy-box__rating">
      <%= star_rating product.rating, size: 16 %>
      <strong><%= number_with_precision(product.rating, precision: 1, separator: ",") %></strong>
      <%= link_to "(#{product.reviews_count} avis)", "#avis", class: "buy-box__reviews-link" %>
    </p>
  </div>

  <div class="buy-box__pricing">
    <span class="buy-box__price" data-variant-target="price"><%= priced.formatted_price %></span>
    <% compare_at = priced.formatted_compare_at_price %>
    <span class="buy-box__compare" data-variant-target="compareAt" <%= "hidden" if compare_at.blank? %>><%= compare_at %></span>
    <% if product.discount_percentage.present? %>
      <span class="tag tag--sale">Liquidation -<%= product.discount_percentage %>%</span>
    <% end %>
  </div>

  <p class="buy-box__taxes">
    Taxes incluses<%= ". Livraison gratuite" if current_store.free_shipping? %>.
    <span class="buy-box__stock">
      <span class="buy-box__dot"></span>
      En stock
    </span>
  </p>

  <%= form_with url: cart_lines_path, method: :post, id: "formulaire-achat",
                data: { controller: "quantity checkout" }, class: "buy-box__form" do |form| %>
    <%= form.hidden_field :product_id, value: product.id %>

    <% if product.variants? %>
      <fieldset class="swatches" id="couleurs">
        <legend class="swatches__legend">
          <span>Couleur</span>
          <strong data-variant-target="name"><%= variant&.name %></strong>
        </legend>

        <div class="swatches__grid">
          <% product.available_variants.each do |item| %>
            <label class="swatch <%= "is-active" if item == variant %>"
                   data-variant-target="swatch"
                   data-variant-id="<%= item.id %>"
                   title="<%= item.name %>">
              <%= form.radio_button :variant_id, item.id,
                    checked: item == variant,
                    class: "swatch__input",
                    data: { action: "change->variant#select" }.merge(variant_data(item)) %>
              <span class="swatch__media">
                <%= variant_image_tag item, alt: item.name, thumb: 150, loading: "lazy", decoding: "async" %>
              </span>
              <span class="swatch__name"><%= item.name %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <div class="buy-box__actions">
      <div class="stepper" role="group" aria-label="Quantite">
        <button type="button" class="stepper__button" data-action="quantity#decrement" aria-label="Diminuer la quantite">
          <%= icon "minus", size: 18 %>
        </button>
        <%= form.number_field :quantity, value: 1, min: 1, max: 99, class: "stepper__input",
              inputmode: "numeric", "aria-label": "Quantite",
              data: { quantity_target: "input", action: "change->quantity#clamp" } %>
        <button type="button" class="stepper__button" data-action="quantity#increment" aria-label="Augmenter la quantite">
          <%= icon "plus", size: 18 %>
        </button>
      </div>

      <button type="button"
              class="wishlist"
              data-controller="wishlist"
              data-wishlist-key-value="<%= product.slug %>"
              data-wishlist-saved-class="is-saved"
              data-action="wishlist#toggle"
              aria-pressed="false"
              aria-label="Ajouter aux favoris">
        <%= icon "heart", size: 20 %>
      </button>

      <%= form.button type: "submit", class: "button button--lg button--block buy-box__submit" do %>
        <%= icon "bag", size: 20 %>
        <span>Ajouter au panier</span>
      <% end %>
    </div>

    <%# Same form, but this button carries the customer straight to the address step. %>
    <%= button_tag "Acheter maintenant", type: "submit", name: "then", value: "checkout",
          class: "button button--lg button--ghost button--block" %>
  <% end %>

  <% reassurance_source = product.content["reassurance"].reject { |item| item["title"].to_s.match?(/garantie/i) } %>
  <% reassurance_items = [
    reassurance_source.find { |item| item["icon"] == "truck" || item["title"].to_s.match?(/livraison|expedition/i) },
    reassurance_source.find { |item| item["title"].to_s.match?(/paiement/i) },
    reassurance_source.find { |item| item["title"].to_s.match?(/retour/i) }
  ].compact %>
  <ul class="buy-box__reassurance" role="list">
    <% reassurance_items.each do |item| %>
      <% title = item["icon"] == "truck" ? item["body"] : item["title"] %>
      <% body = item["icon"] == "truck" ? item["title"] : item["body"] %>
      <li>
        <%= icon item["icon"], size: 20 %>
        <span>
          <strong><%= title %></strong>
          <small><%= body %></small>
        </span>
      </li>
    <% end %>
  </ul>
</div>
