<section class="footer-cta">
  <div class="page-container footer-cta__inner">
    <div>
      <h2 class="footer-cta__title"><%= product.name %></h2>
      <p class="footer-cta__price">
        <strong><%= (product.default_variant || product).formatted_price %></strong>
        <% if product.discount_percentage.present? %>
          <span class="footer-cta__compare"><%= product.formatted_compare_at_price %></span>
          <span class="tag tag--sale">-<%= product.discount_percentage %>%</span>
        <% end %>
      </p>
    </div>

    <%= link_to "Commander maintenant", storefront_product_path(product.slug), class: "button button--lg button--invert" %>
  </div>
</section>
