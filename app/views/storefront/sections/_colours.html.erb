<section class="colours" id="<%= id %>">
  <div class="page-container">
    <div class="section-head">
      <div>
        <p class="section-head__eyebrow"><%= t("sections.available_colours") %></p>
        <h2 class="section-heading"><%= heading %></h2>
      </div>
      <%= link_to storefront_product_path(product.slug), class: "section-head__link" do %>
        <span><%= t("sections.see_all") %></span>
        <%= icon "chevron-right", size: 16 %>
      <% end %>
    </div>

    <ul class="colours__grid" role="list">
      <% product.available_variants.each do |variant| %>
        <li>
          <%= link_to storefront_product_path(product.slug, option: variant.id), class: "colour-card" do %>
            <span class="colour-card__media">
              <%= variant_image_tag variant, alt: "#{product.display_name} - #{variant.display_name}",
                    class: "colour-card__image", loading: "lazy", decoding: "async" %>
            </span>
            <span class="colour-card__foot">
              <span class="colour-card__name"><%= variant.display_name %></span>
              <span class="colour-card__price"><%= variant.formatted_price %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
