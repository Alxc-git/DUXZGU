<section class="faq" id="faq" data-controller="faq" data-faq-open-class="faq__item--open">
  <div class="page-container faq__inner">
    <div class="faq__intro">
      <p class="faq__eyebrow"><%= t("sections.faq_eyebrow") %></p>
      <h2 class="section-heading"><%= t("sections.faq_title") %></h2>
      <p class="faq__lead"><%= t("sections.faq_lead") %></p>

      <div class="faq__support-stack">
        <div class="faq__support-card">
          <span class="faq__support-icon"><%= icon "lock", size: 20 %></span>
          <div>
            <strong><%= t("sections.payment_protected") %></strong>
            <span><%= t("sections.payment_protected_body") %></span>
            <%= payment_marks(class: "payment-marks--sm faq__support-marks") %>
          </div>
        </div>

        <div class="faq__support-card">
          <span class="faq__support-icon"><%= icon "headset", size: 20 %></span>
          <div>
            <strong><%= t("sections.question_before") %></strong>
            <span><%= t("sections.team_replies") %></span>
            <% if current_store&.support_email.present? %>
              <%= mail_to current_store.support_email, class: "faq__support-link" do %>
                <span><%= current_store.support_email %></span>
                <%= icon "chevron-right", size: 16 %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="faq__list">
      <% faq_icons = %w[truck drop refresh shield lock] %>
      <% product.content["faq"].each_with_index do |entry, index| %>
        <details class="faq__item" <%= "open" if index.zero? %> data-faq-target="item" data-action="toggle->faq#sync">
          <summary class="faq__question" data-action="click->faq#toggle">
            <span class="faq__number"><%= format("%02d", index + 1) %></span>
            <span class="faq__question-icon"><%= icon faq_icons[index % faq_icons.length], size: 18 %></span>
            <span><%= entry["question"] %></span>
            <%= icon "chevron-down", size: 20, class: "faq__chevron" %>
          </summary>
          <p class="faq__answer"><%= entry["answer"] %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>
