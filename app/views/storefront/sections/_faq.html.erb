<section class="faq" id="faq">
  <div class="page-container faq__inner">
    <h2 class="section-heading">Questions frequentes</h2>

    <div class="faq__list">
      <% product.content["faq"].each do |entry| %>
        <details class="faq__item">
          <summary class="faq__question">
            <span><%= entry["question"] %></span>
            <%= icon "chevron-down", size: 20, class: "faq__chevron" %>
          </summary>
          <p class="faq__answer"><%= entry["answer"] %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>
