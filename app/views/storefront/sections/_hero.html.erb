<section class="hero">
  <div class="page-container hero__grid">
    <div class="hero__content">
      <p class="hero__eyebrow"><%= product.content["eyebrow"] %></p>

      <h1 class="hero__title">
        <span><%= product.content["headline_lead"] %></span>
        <span><%= product.content["headline_trail"] %></span>
      </h1>

      <p class="hero__subhead"><%= product.content["subhead"] %></p>

      <div class="hero__actions">
        <%= link_to "Decouvrir la montre", storefront_product_path(product.slug), class: "button button--lg" %>
        <%= link_to "Voir les couleurs", root_path(anchor: "couleurs"), class: "button button--lg button--ghost" %>
      </div>

      <ul class="hero__trust">
        <% product.content["reassurance"].each do |item| %>
          <li>
            <%= icon item["icon"], size: 20 %>
            <span><%= item["title"] %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="hero__media">
      <%= variant_image_tag product.default_variant, alt: product.name,
            class: "hero__image", fetchpriority: "high", decoding: "async" %>
    </div>
  </div>
</section>
