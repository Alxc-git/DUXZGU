<% content_for :title, "Tableau de bord | Admin" %>
<% report = @report %>
<% money = ->(cents) { MoneyFormatter.format(cents, report.currency) } %>

<header class="admin-page-head">
  <div>
    <p class="admin-page-head__eyebrow">Vue d'ensemble</p>
    <h1>Tableau de bord</h1>
    <p class="admin-page-head__lead">
      <%= @selected_store&.name || "Toutes les boutiques" %> &mdash;
      <%= Analytics::Report::PERIODS[report.days].downcase %>,
      compare aux <%= Analytics::Report::PERIODS[report.days].downcase %> precedents.
    </p>
  </div>

  <%= form_with url: admin_root_path, method: :get, class: "admin-filters", data: { turbo_frame: "_top" } do |form| %>
    <%= form.select :store_id,
          options_from_collection_for_select(@stores, :id, :name, @selected_store&.id),
          { include_blank: "Toutes les boutiques" },
          class: "admin-select", onchange: "this.form.requestSubmit()" %>
    <%= form.select :days,
          options_for_select(Analytics::Report::PERIODS.map { |value, label| [ label, value ] }, report.days),
          {},
          class: "admin-select", onchange: "this.form.requestSubmit()" %>
    <noscript><%= form.submit "Appliquer", class: "button button--secondary" %></noscript>
  <% end %>
</header>


<%# Today, whatever period the rest of the page is set to. Someone opening the
    admin at noon wants to know how the day is going; no thirty-day average can
    answer that, and it is the first thing anyone looks for. %>
<% today = report.today %>
<% yesterday = report.yesterday %>
<section class="today" aria-label="Chiffres du jour">
  <div class="today__head">
    <span class="today__pulse" aria-hidden="true"></span>
    <div>
      <h2>Aujourd'hui</h2>
      <p><%= l(Date.current, format: :long) rescue Date.current.to_s %> &mdash; compare a la meme heure hier</p>
    </div>
  </div>

  <dl class="today__figures">
    <% [
         [ "Visites", number_with_delimiter(today[:visits]), today[:visits], yesterday[:visits] ],
         [ "Commandes", number_with_delimiter(today[:orders]), today[:orders], yesterday[:orders] ],
         [ "Revenus", money.call(today[:revenue_cents]), today[:revenue_cents], yesterday[:revenue_cents] ],
         [ "Profit", money.call(today[:profit_cents]), today[:profit_cents], yesterday[:profit_cents] ]
       ].each do |label, shown, now, before| %>
      <div class="today__figure">
        <dt><%= label %></dt>
        <dd><%= shown %></dd>
        <%# No baseline means no percentage: "+100 %" against zero says nothing. %>
        <% if before.to_i.zero? %>
          <span class="today__delta today__delta--none">hier : <%= before.to_i.zero? ? "0" : before %></span>
        <% else %>
          <% change = ((now - before) * 100.0) / before %>
          <span class="today__delta today__delta--<%= change.negative? ? "down" : "up" %>">
            <%= icon(change.negative? ? "trend-down" : "trend-up", size: 13) %>
            <%= "#{change.positive? ? "+" : ""}#{number_with_precision(change, precision: 0)} %" %>
          </span>
        <% end %>
      </div>
    <% end %>
  </dl>
</section>
<%# The six numbers that answer "is the site working?", each against its own past. %>
<div class="kpi-row">
  <%= render "admin/dashboard/kpi", label: "Visites", value: number_with_delimiter(report.visits),
        delta: report.delta(:visits), hint: "Sessions ouvertes" %>
  <%= render "admin/dashboard/kpi", label: "Rebond",
        value: "#{number_with_precision(report.bounce_rate, precision: 1, separator: ',')} %",
        delta: report.delta(:bounce_rate), hint: "Repartis apres une seule page", invert: true %>
  <%= render "admin/dashboard/kpi", label: "Pages vues", value: number_with_delimiter(report.page_views),
        delta: report.delta(:page_views),
        hint: "#{number_with_precision(report.pages_per_visit, precision: 1, separator: ',')} par visite" %>
  <%= render "admin/dashboard/kpi", label: "Commandes", value: number_with_delimiter(report.orders),
        delta: report.delta(:orders), hint: "Toutes commandes creees" %>
  <%= render "admin/dashboard/kpi", label: "Revenus", value: money.call(report.revenue_cents),
        delta: report.delta(:revenue_cents),
        hint: "Panier moyen #{money.call(report.average_order_cents)}" %>
  <%# One tile, always the truest number available: the margin after the supplier
      until advertising is recorded, the result after both once it is. %>
  <% if report.advertising? %>
    <%= render "admin/dashboard/kpi", label: "Profit net", value: money.call(report.net_profit_cents),
          delta: report.delta(:net_profit_cents),
          hint: "Apres fournisseur et #{money.call(report.ad_spend_cents)} de pub" %>
  <% else %>
    <%= render "admin/dashboard/kpi", label: "Profit", value: money.call(report.profit_cents),
          delta: report.delta(:profit_cents),
          hint: "Marge #{number_with_precision(report.margin_rate, precision: 1, separator: ",")} % apres fournisseur" %>
  <% end %>
</div>

<% unless report.any_traffic? %>
  <div class="admin-notice">
    <strong>Aucune visite enregistree sur la periode.</strong>
    <p>
      Le suivi demarre a la premiere page ouverte par un visiteur. Ouvrez la boutique
      dans une fenetre privee pour verifier qu'il fonctionne &mdash; vos propres pages
      d'administration ne sont jamais comptees.
    </p>
  </div>
<% end %>

<div class="admin-grid admin-grid--charts">
  <section class="admin-card">
    <header class="admin-card__head">
      <h2>Trafic</h2>
      <span class="admin-card__note">Visites et pages vues par jour</span>
    </header>
    <%= line_chart id: "chart-trafic", points: report.series, series: [
          { key: :visits, label: "Visites", color: "#2a78d6", fill: true },
          { key: :page_views, label: "Pages vues", color: "#eb6834" }
        ] %>
  </section>

  <section class="admin-card">
    <header class="admin-card__head">
      <h2>Revenus</h2>
      <span class="admin-card__note">Commandes payees par jour</span>
    </header>
    <%= bar_chart id: "chart-revenus", points: report.series, key: :revenue_cents,
          formatter: ->(cents) { MoneyFormatter.format(cents, report.currency) } %>
  </section>
</div>


<div class="admin-grid admin-grid--split">
  <%# Where people leave. Counted in sessions rather than page views: someone who
      reloads the cart three times has still only reached the cart once, and views
      would invent a drop that is not there. %>
  <section class="admin-card">
    <header class="admin-card__head">
      <h2>Parcours d'achat</h2>
      <span class="admin-card__note">Sessions ayant atteint chaque etape</span>
    </header>

    <ol class="funnel" role="list">
      <% report.funnel.each do |step| %>
        <li class="funnel__step">
          <div class="funnel__line">
            <span class="funnel__label"><%= step[:label] %></span>
            <span class="funnel__count"><%= number_with_delimiter(step[:count]) %></span>
            <span class="funnel__share"><%= number_with_precision(step[:share], precision: 1, separator: ",") %> %</span>
          </div>
          <div class="funnel__track">
            <div class="funnel__bar" style="width: <%= [ step[:share], 100 ].min.round(2) %>%"></div>
          </div>
          <% if step[:drop].present? && step[:drop] > 0 %>
            <p class="funnel__drop">
              <%= number_with_precision(step[:drop], precision: 0) %> % perdus a cette etape
            </p>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <%# Which option actually sells: it decides the photo in the next ad. %>
  <section class="admin-card">
    <header class="admin-card__head">
      <h2>Ventes par option</h2>
      <span class="admin-card__note">Commandes payees sur la periode</span>
    </header>

    <% if report.top_variants.any? %>
      <table class="admin-table admin-table--compact">
        <thead>
          <tr><th>Option</th><th class="is-numeric">Ventes</th><th class="is-numeric">Revenus</th><th class="is-numeric">Part</th></tr>
        </thead>
        <tbody>
          <% report.top_variants.each do |row| %>
            <tr>
              <td><%= row[:label] %></td>
              <td class="is-numeric"><%= row[:count] %></td>
              <td class="is-numeric"><%= money.call(row[:revenue_cents]) %></td>
              <td class="is-numeric"><%= number_with_precision(row[:share], precision: 1, separator: ",") %> %</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="admin-empty">Aucune vente sur la periode.</p>
    <% end %>
  </section>
</div>

<%# The table that decides where the next ad dollar goes. Traffic comes from the
    UTM tags on the landing visit, the money from the campaign frozen onto the
    order at checkout. Profit rather than revenue: a campaign can bring sales in
    and still lose money once the supplier is paid. %>
<section class="admin-card">
  <header class="admin-card__head">
    <h2>Campagnes</h2>
    <span class="admin-card__note">Trafic balise UTM, revenus attribues a la commande</span>
  </header>

  <% if report.campaigns.any? %>
    <table class="admin-table admin-table--compact">
      <thead>
        <tr>
          <th>Source</th>
          <th>Campagne</th>
          <th class="is-numeric">Visites</th>
          <th class="is-numeric">Commandes</th>
          <th class="is-numeric">Conv.</th>
          <th class="is-numeric">Revenus</th>
          <th class="is-numeric">Pub</th>
          <th class="is-numeric">ROAS</th>
          <th class="is-numeric">Net</th>
        </tr>
      </thead>
      <tbody>
        <% report.campaigns.each do |row| %>
          <tr>
            <td><strong><%= row[:source] %></strong></td>
            <td><%= row[:campaign] || "&mdash;".html_safe %></td>
            <td class="is-numeric"><%= number_with_delimiter(row[:visits]) %></td>
            <td class="is-numeric"><%= row[:orders] %></td>
            <td class="is-numeric"><%= number_with_precision(row[:conversion_rate], precision: 2, separator: ",") %> %</td>
            <td class="is-numeric"><%= money.call(row[:revenue_cents]) %></td>
            <td class="is-numeric"><%= row[:spend_cents].positive? ? money.call(row[:spend_cents]) : "&mdash;".html_safe %></td>
            <%# Below 1 the campaign does not even earn back its own media. %>
            <td class="is-numeric <%= row[:roas] && row[:roas] < 1 ? "is-negative" : nil %>">
              <%= row[:roas] ? "#{number_with_precision(row[:roas], precision: 2, separator: ",")} x" : "&mdash;".html_safe %>
            </td>
            <td class="is-numeric <%= row[:net_profit_cents].negative? ? "is-negative" : "is-positive" %>"><%= money.call(row[:net_profit_cents]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="admin-empty">
      Aucune visite balisee. Ajoutez <code>?utm_source=facebook&amp;utm_campaign=nom-de-la-pub</code>
      a la fin de vos liens publicitaires : la source est figee sur la commande et remonte ici.
    </p>
  <% end %>
</section>
<div class="admin-grid admin-grid--thirds">
  <section class="admin-card">
    <header class="admin-card__head">
      <h2>Sources de trafic</h2>
      <span class="admin-card__note">D'ou viennent les visites</span>
    </header>
    <%= breakdown_list report.top_sources %>
  </section>

  <section class="admin-card">
    <header class="admin-card__head">
      <h2>Pages les plus vues</h2>
    </header>
    <%= breakdown_list report.top_pages %>
  </section>

  <section class="admin-card">
    <header class="admin-card__head">
      <h2>Appareils</h2>
    </header>
    <%= breakdown_list report.devices %>
  </section>
</div>

<div class="admin-grid admin-grid--split">
  <section class="admin-card">
    <header class="admin-card__head">
      <h2>Toutes vos boutiques</h2>
      <span class="admin-card__note">Sur la meme periode</span>
    </header>

    <table class="admin-table admin-table--compact">
      <thead>
        <tr>
          <th>Boutique</th>
          <th class="is-numeric">Visites</th>
          <th class="is-numeric">Commandes</th>
          <th class="is-numeric">Revenus</th>
        </tr>
      </thead>
      <tbody>
        <% report.stores_summary.each do |row| %>
          <tr>
            <td>
              <%= link_to row[:store].name, admin_root_path(store_id: row[:store].id, days: report.days) %>
              <span class="admin-table__sub"><%= row[:store].domain %></span>
            </td>
            <td class="is-numeric"><%= number_with_delimiter(row[:visits]) %></td>
            <td class="is-numeric"><%= number_with_delimiter(row[:orders]) %></td>
            <td class="is-numeric"><%= MoneyFormatter.format(row[:revenue_cents], row[:store].currency) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <section class="admin-card">
    <header class="admin-card__head">
      <h2>A traiter</h2>
    </header>

    <ul class="attention" role="list">
      <li class="attention__row <%= "attention__row--alert" if @attention[:supplier_errors].positive? %>">
        <span class="attention__count"><%= @attention[:supplier_errors] %></span>
        <span>
          <strong>Erreurs fournisseur</strong>
          <small>Commandes que le fournisseur a refusees</small>
        </span>
        <%= link_to "Voir", admin_fulfillment_path, class: "attention__link" %>
      </li>
      <li class="attention__row <%= "attention__row--warn" if @attention[:awaiting_fulfillment].positive? %>">
        <span class="attention__count"><%= @attention[:awaiting_fulfillment] %></span>
        <span>
          <strong>En attente d'expedition</strong>
          <small>Payees, pas encore transmises</small>
        </span>
        <%= link_to "Voir", admin_fulfillment_path, class: "attention__link" %>
      </li>
      <li class="attention__row">
        <span class="attention__count"><%= @attention[:unpaid] %></span>
        <span>
          <strong>Paniers abandonnes</strong>
          <small>Commandes non payees, 48 dernieres heures</small>
        </span>
      </li>
    </ul>
  </section>
</div>

<section class="admin-card">
  <header class="admin-card__head">
    <h2>Dernieres commandes</h2>
    <%= link_to "Toutes les commandes", admin_orders_path, class: "admin-card__link" %>
  </header>

  <% if @recent_orders.any? %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Commande</th>
          <th>Client</th>
          <th>Produit</th>
          <th>Statut</th>
          <th class="is-numeric">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_orders.each do |order| %>
          <tr>
            <td>
              <%= link_to order.metadata["checkout_reference"].presence || "##{order.id}", admin_order_path(order) %>
              <span class="admin-table__sub"><%= admin_short_datetime(order.created_at) %></span>
            </td>
            <td><%= order.customer_name.presence || order.email.presence || "&mdash;".html_safe %></td>
            <td><%= order.line_item_name %></td>
            <td><span class="status status--<%= order.status %>"><%= order_status_label(order.status) %></span></td>
            <td class="is-numeric"><%= order.formatted_total %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="admin-empty">Aucune commande pour l'instant.</p>
  <% end %>
</section>
