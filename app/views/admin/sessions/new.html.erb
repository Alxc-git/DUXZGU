<section class="card" style="max-width: 420px;">
  <h1>Admin login</h1>
  <%= form_with url: admin_login_path, class: "form" do |form| %>
    <div class="form__field">
      <%= form.label :email %>
      <%= form.email_field :email, class: "form__input", required: true %>
    </div>
    <div class="form__field">
      <%= form.label :password %>
      <%= form.password_field :password, class: "form__input", required: true %>
    </div>
    <%= form.submit "Login", class: "button" %>
  <% end %>
</section>
