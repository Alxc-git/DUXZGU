<% content_for :title, "Approvisionnement CJ | Admin" %>
<% money = ->(cents) { MoneyFormatter.format(cents, @currency) } %>

<header class="admin-page-head">
  <div>
    <p class="admin-page-head__eyebrow">Fournisseur</p>
    <h1>Approvisionnement CJ</h1>
    <p class="admin-page-head__lead">
      CJ preleve sur un solde prepaye. Quand ce solde tombe a zero, les commandes
      restent payees par le client mais ne partent pas : elles s'accumulent ici.
    </p>
  </div>

  <%= form_with url: admin_fulfillment_path, method: :get, class: "admin-filters", data: { turbo_frame: "_top" } do |form| %>
    <%= form.select :store_id,
          options_from_collection_for_select(@stores, :id, :name, @store&.id),
          { include_blank: "Toutes les boutiques" },
          class: "admin-select", onchange: "this.form.requestSubmit()" %>
    <noscript><%= form.submit "Appliquer", class: "button button--secondary" %></noscript>
  <% end %>
</header>


<%# CJ stops fulfilling the moment its balance runs dry, and it stops after the
    customer has been charged. Nobody catches that by watching a number: they
    catch it when orders start failing. A countdown does the watching instead. %>
<% forecast = @forecast %>
<section class="credit credit--<%= forecast.level %>">
  <div class="credit__state">
    <p class="credit__label">Solde CJ estime</p>
    <% if forecast.remaining_cents %>
      <p class="credit__value"><%= money.call(forecast.remaining_cents) %></p>
      <p class="credit__note">
        Enregistre le <%= l(@store&.cj_balance_recorded_at || Store.first.cj_balance_recorded_at, format: :short) %>,
        moins ce qui est parti chez CJ depuis.
      </p>
    <% else %>
      <p class="credit__value">&mdash;</p>
      <p class="credit__note">Aucun solde enregistre. Saisissez-le apres votre prochain credit.</p>
    <% end %>
  </div>

  <div class="credit__forecast">
    <% case forecast.level %>
    <% when :unknown %>
      <p class="credit__headline">Decompte indisponible</p>
      <p class="credit__body">
        Saisissez le montant credite chez CJ et cette case vous dira combien de
        jours il tient au rythme actuel.
      </p>
    <% when :critical %>
      <p class="credit__headline">
        <%= icon "alert", size: 17 %>
        <% if forecast.covers_pending? %>
          Il reste environ <%= pluralize(forecast.days_left, "jour") %>
        <% else %>
          Solde insuffisant pour les commandes en attente
        <% end %>
      </p>
      <p class="credit__body">
        <% unless forecast.covers_pending? %>
          Il faut <strong><%= money.call(forecast.pending_cents) %></strong> pour ecouler
          ce qui est deja paye, et le solde estime ne les couvre pas.
        <% end %>
        Creditez CJ maintenant : chaque commande encaissee sans credit reste bloquee.
      </p>
    <% when :low %>
      <p class="credit__headline">Il reste environ <%= pluralize(forecast.days_left, "jour") %></p>
      <p class="credit__body">
        Au rythme des <%= Fulfillment::CreditForecast::BURN_WINDOW %> derniers jours,
        soit <%= money.call(forecast.daily_burn_cents) %> par jour. Prevoyez le prochain credit.
      </p>
    <% else %>
      <p class="credit__headline">
        <%= forecast.days_left ? "Environ #{pluralize(forecast.days_left, "jour")} de marge" : "Aucune consommation recente" %>
      </p>
      <p class="credit__body">
        <%= forecast.daily_burn_cents.positive? ?
              "#{money.call(forecast.daily_burn_cents)} par jour en moyenne sur #{Fulfillment::CreditForecast::BURN_WINDOW} jours." :
              "Rien n'a ete envoye a CJ recemment, donc rien a decompter." %>
      </p>
    <% end %>
  </div>

  <%= form_with url: cj_balance_admin_fulfillment_path(store_id: params[:store_id]),
        method: :patch, class: "credit__form" do |form| %>
    <%= form.label :balance, "Nouveau solde apres credit", class: "credit__field-label" %>
    <div class="credit__field">
      <%= form.text_field :balance, placeholder: "200,00", inputmode: "decimal",
            required: true, class: "form__input" %>
      <%= form.submit "Enregistrer", class: "button button--secondary" %>
    </div>
  <% end %>
</section>
<%# The three numbers that decide whether action is needed right now. %>
<div class="kpi-row kpi-row--trio">
  <article class="kpi">
    <p class="kpi__label">Commandes bloquees</p>
    <p class="kpi__value"><%= @blocked.size %></p>
    <p class="kpi__foot"><span class="kpi__hint">Payees, pas encore acceptees par CJ</span></p>
  </article>

  <article class="kpi">
    <p class="kpi__label">Credit CJ necessaire</p>
    <p class="kpi__value"><%= money.call(@credit_needed_cents) %></p>
    <p class="kpi__foot"><span class="kpi__hint">Cout fournisseur pour tout ecouler</span></p>
  </article>

  <article class="kpi">
    <p class="kpi__label">Deja encaisse</p>
    <p class="kpi__value"><%= money.call(@collected_cents) %></p>
    <p class="kpi__foot"><span class="kpi__hint">Ce que ces clients ont deja paye</span></p>
  </article>
</div>

<section class="admin-card">
  <div class="admin-card__head">
    <h2>Commandes bloquees</h2>
    <% if @blocked.any? %>
      <%= button_to "Tout renvoyer a CJ",
            retry_all_admin_fulfillment_path(store_id: params[:store_id]),
            class: "button", form: { data: { turbo_confirm: "Renvoyer #{@blocked.size} commande(s) a CJ ?" } } %>
    <% end %>
  </div>

  <% if @blocked.empty? %>
    <p class="admin-empty">Rien en attente : tout ce qui a ete paye est parti chez CJ.</p>
  <% else %>
    <p class="admin-card__note">
      Creditez votre compte CJ d'au moins <strong><%= money.call(@credit_needed_cents) %></strong>,
      puis appuyez sur &laquo;&nbsp;Tout renvoyer a CJ&nbsp;&raquo;. Un balayage automatique
      retente aussi ces commandes toutes les heures.
    </p>

    <table class="admin-table">
      <thead>
        <tr>
          <th>#</th><th>Client</th><th>Produit</th><th>Qte</th>
          <th>Paye</th><th>Cout CJ</th><th>Etat CJ</th><th>Paye depuis</th>
        </tr>
      </thead>
      <tbody>
        <% @blocked.each do |order| %>
          <tr>
            <td><%= link_to order.id, admin_order_path(order) %></td>
            <td>
              <%= order.customer_name.presence || "&mdash;".html_safe %><br>
              <small><%= order.email %></small>
            </td>
            <td><%= order.product.name %><br><small><%= order.variant&.name %></small></td>
            <td><%= order.quantity %></td>
            <td><%= order.formatted_total %></td>
            <td><%= MoneyFormatter.format(order.supplier_cost_cents, order.currency) %></td>
            <td>
              <% if order.supplier_status == "failed" %>
                <span class="status status--failed">Refusee</span>
              <% else %>
                <span class="status status--paid">En attente</span>
              <% end %>
            </td>
            <td><%= order.paid_at ? "#{time_ago_in_words(order.paid_at)}" : "&mdash;".html_safe %></td>
          </tr>
          <%# Everything needed to place this order by hand on CJ, in one place:
              when the button cannot get it through, the alternative is retyping
              it into CJ's form, and hunting for the address across three screens
              is how a parcel ends up at the wrong door. %>
          <tr class="manual-order">
            <td colspan="8">
              <details>
                <summary>Details pour commander a la main chez CJ</summary>

                <div class="manual-order__grid">
                  <section class="manual-order__block">
                    <h3>Destinataire</h3>
                    <p class="manual-order__address"><%=
                      safe_join([
                        order.customer_name.presence,
                        order.address_line1.presence,
                        order.address_line2.presence,
                        [ order.city.presence, order.province.presence, order.postal_code.presence ].compact_blank.join(", ").presence,
                        [ Suppliers::Cj::Countries.name_for(order.country.to_s.upcase), order.country.to_s.upcase ].compact_blank.join(" - ").presence
                      ].compact, tag.br)
                    %></p>

                    <dl class="manual-order__list">
                      <dt>Telephone</dt><dd><%= order.phone.presence || "non fourni" %></dd>
                      <dt>Courriel</dt><dd><%= order.email %></dd>
                    </dl>
                  </section>

                  <section class="manual-order__block">
                    <h3>A commander chez CJ</h3>
                    <dl class="manual-order__list">
                      <dt>Numero a utiliser</dt><dd><code>ORD-<%= order.id %></code></dd>
                      <dt>Article</dt><dd><%= order.line_item_name %></dd>
                      <dt>Variant CJ (vid)</dt><dd><code><%= order.supplier_variant_id.presence || "MANQUANT" %></code></dd>
                      <dt>SKU</dt><dd><code><%= order.variant&.supplier_sku.presence || order.product.supplier_sku.presence || "&mdash;".html_safe %></code></dd>
                      <dt>Quantite</dt><dd><%= order.quantity %></dd>
                      <dt>Transporteur promis</dt><dd><%= order.shipping_carrier.presence || "au choix de CJ" %></dd>
                    </dl>
                  </section>
                </div>

                <p class="manual-order__note">
                  Reprenez bien <code>ORD-<%= order.id %></code> comme numero de commande :
                  c'est celui que le site enverra aussi s'il retente, et CJ refuse un doublon,
                  ce qui evite de payer deux fois le meme colis.
                </p>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<div class="admin-grid admin-grid--split">
  <section class="admin-card">
    <div class="admin-card__head"><h2>Chez CJ</h2></div>
    <% if @at_supplier.empty? %>
      <p class="admin-empty">Aucune commande en preparation.</p>
    <% else %>
      <table class="admin-table">
        <thead><tr><th>#</th><th>Client</th><th>Commande CJ</th><th>Envoyee</th></tr></thead>
        <tbody>
          <% @at_supplier.each do |order| %>
            <tr>
              <td><%= link_to order.id, admin_order_path(order) %></td>
              <td><small><%= order.email %></small></td>
              <td><small><%= order.supplier_order_id %></small></td>
              <td><%= order.submitted_to_supplier_at ? l(order.submitted_to_supplier_at, format: :short) : "&mdash;".html_safe %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <section class="admin-card">
    <div class="admin-card__head"><h2>Expediees</h2></div>
    <% if @on_its_way.empty? %>
      <p class="admin-empty">Aucun colis en route.</p>
    <% else %>
      <table class="admin-table">
        <thead><tr><th>#</th><th>Client</th><th>Suivi</th><th>Etat</th></tr></thead>
        <tbody>
          <% @on_its_way.each do |order| %>
            <tr>
              <td><%= link_to order.id, admin_order_path(order) %></td>
              <td><small><%= order.email %></small></td>
              <td>
                <% if order.tracking_url.present? %>
                  <%= link_to order.tracking_number, order.tracking_url, target: "_blank", rel: "noopener" %>
                <% else %>
                  <small><%= order.tracking_number.presence || "&mdash;".html_safe %></small>
                <% end %>
              </td>
              <td><span class="status status--<%= order.delivered? ? "delivered" : "shipped" %>"><%= order.delivered? ? "Livree" : "Expediee" %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
</div>
