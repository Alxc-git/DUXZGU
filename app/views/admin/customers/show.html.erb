<div class="admin-main__header"><h1><%= @customer.email %></h1></div>

<section class="card">
  <p><strong>Name:</strong> <%= @customer.full_name %></p>
  <p><strong>Store:</strong> <%= @customer.store.name %></p>
  <p><strong>Phone:</strong> <%= @customer.phone %></p>
  <p><strong>Stripe customer:</strong> <%= @customer.stripe_customer_id %></p>
</section>

<h2>Orders</h2>
<table class="admin-table">
  <thead><tr><th>ID</th><th>Total</th><th>Status</th><th>Created</th></tr></thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td><%= link_to order.id, admin_order_path(order) %></td>
        <td><%= order.formatted_total %></td>
        <td><%= order.status %></td>
        <td><%= l(order.created_at, format: :short) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
