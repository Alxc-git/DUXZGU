<div style="font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #111111; max-width: 560px; margin: 0 auto; padding: 24px;">
  <p style="font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #6b6b6b; margin: 0 0 6px;">
    <%= @store.name %>
  </p>
  <h1 style="font-size: 24px; margin: 0 0 8px;"><%= t("mailer.newsletter_title", amount: @amount) %></h1>
  <p style="color: #4a4a4a; line-height: 1.55; margin: 0 0 24px;">
    <%= t("mailer.newsletter_body") %>
  </p>

  <div style="border: 1px solid #e3e3de; border-radius: 8px; padding: 20px 16px; margin-bottom: 20px; text-align: center;">
    <p style="margin: 0 0 8px; font-size: 13px; color: #6b6b6b;"><%= t("mailer.newsletter_code_label") %></p>
    <p style="margin: 0; font-size: 26px; font-weight: 700; letter-spacing: 0.1em;"><%= @discount.code %></p>
    <% if @discount.minimum_cents.positive? %>
      <p style="margin: 10px 0 0; font-size: 13px; color: #6b6b6b;">
        <%= t("mailer.newsletter_minimum", amount: MoneyFormatter.format(@discount.minimum_cents, @store.currency)) %>
      </p>
    <% end %>
    <% if @discount.expires_at.present? %>
      <p style="margin: 6px 0 0; font-size: 13px; color: #6b6b6b;">
        <%= t("mailer.newsletter_expires", date: l(@discount.expires_at.to_date, format: "%-d %B %Y")) %>
      </p>
    <% end %>
  </div>

  <p style="margin: 0 0 28px;">
    <a href="<%= root_url(host: @store.domain) %>" style="display: inline-block; background: #111111; color: #ffffff; text-decoration: none; padding: 13px 22px; border-radius: 8px; font-weight: 700;">
      <%= t("mailer.newsletter_cta") %>
    </a>
  </p>

  <%# CASL: a commercial message has to name its sender and offer a way out. %>
  <p style="color: #6b6b6b; font-size: 13px; line-height: 1.6; margin: 0;">
    <%= t("mailer.question") %><% if @store.support_email.present? %>
    <%= t("mailer.or_write", email: @store.support_email) %><% end %>.
    <br><%= t("mailer.newsletter_unsubscribe") %>
  </p>
</div>
