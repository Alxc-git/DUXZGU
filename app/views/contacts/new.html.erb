<% content_for :title, "Contact | #{current_store.name}" %>

<div class="page stack" style="padding-top:var(--space-8);max-width:840px">
  <div class="card checkout__section">
    <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">Support</p>
    <h1 style="font-size:var(--fs-display-3)">Contact us</h1>
    <p class="sub">Questions about an order, delivery or the product? Send a message to the store support inbox.</p>
  </div>

  <%= form_with model: @message, scope: :contact_message, url: contact_path, class: "card checkout__section" do |form| %>
    <% if @message.errors.any? %>
      <div role="alert">
        <div class="stat__label">Please check the following</div>
        <ul>
          <% @message.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="checkout__grid checkout__grid--2">
      <%= form.text_field :name, class: "input", placeholder: "Name", required: true, autocomplete: "name" %>
      <%= form.email_field :email, class: "input", placeholder: "Email", required: true, autocomplete: "email" %>
    </div>

    <span class="select">
      <%= form.select :subject, options_for_select(ContactMessage.subjects, @message.subject), { include_blank: "Subject" }, class: "input" %>
      <span class="select__chev"><%= cj_icon "chevron-down" %></span>
    </span>

    <%= form.text_field :order_reference, class: "input", placeholder: "Order reference" %>
    <%= form.text_area :body, class: "input", rows: 7, placeholder: "Message", required: true %>

    <button class="btn btn--primary btn--lg btn--full" type="submit">
      <%= cj_icon "mail", size: "1.15em" %> Send message
    </button>
  <% end %>
</div>
