<% content_for :title, "Payment | #{current_store.name}" %>
<% content_for :hide_footer, true %>
<% content_for :hide_buy_bar, true %>
<% first = @orders.first %>
<% total = MoneyFormatter.format(@orders.sum(&:total_cents), first.currency) %>

<% if @client_secret.present? %>
  <% content_for :head do %>
    <script src="https://js.stripe.com/v3/"></script>
  <% end %>
<% end %>

<div class="page stack funnel-page funnel-page--tight">
  <%= render "checkouts/steps", current: 1 %>

  <div class="checkout">
    <div class="stack">
      <div class="card checkout__section">
        <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">Secure payment</p>
        <h1 style="font-size:var(--fs-display-3);line-height:1">Payment</h1>
        <div class="pay__total">
          <span class="sub">Amount due today</span>
          <b><%= total %></b>
        </div>
        <div class="pay__methods">
          <%= payment_marks %w[visa mastercard amex paypal], label: "Accepted payment methods", class: "payment-marks--sm" %>
          <span class="trust__item"><%= cj_icon "lock" %><span>256-bit SSL &middot; 3-D Secure</span></span>
        </div>
      </div>

      <% if Payments.paypal_configured? %>
        <div class="card checkout__section">
          <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">Pay with PayPal</p>
          <div class="paypal-block"
               data-controller="paypal-button"
               data-paypal-button-client-id-value="<%= Payments.paypal_client_id %>"
               data-paypal-button-currency-value="<%= first.currency.to_s.upcase %>"
               data-paypal-button-create-url-value="<%= paypal_checkout_path %>"
               data-paypal-button-capture-url-value="<%= paypal_capture_path %>">
            <div class="paypal-block__buttons" data-paypal-button-target="container"></div>
            <p class="paypal-block__error" data-paypal-button-target="error" role="alert" hidden></p>
          </div>
        </div>
        <p class="pay__or">or pay by card</p>
      <% end %>

      <div class="card checkout__section">
        <% if @client_secret.present? %>
          <div style="display:flex;flex-wrap:wrap;gap:var(--space-3);align-items:center">
            <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">Card details</p>
            <%= payment_marks %w[visa mastercard amex], label: "Accepted cards",
                  class: "payment-marks--sm", style: "margin-left:auto" %>
          </div>

          <%# The card number never touches this page: the inputs live in Stripe's iframe. %>
          <form class="payment-form"
                data-controller="stripe-payment"
                data-stripe-payment-key-value="<%= Payments.publishable_key %>"
                data-stripe-payment-secret-value="<%= @client_secret %>"
                data-stripe-payment-return-url-value="<%= checkout_success_url %>"
                data-stripe-payment-locale-value="<%= current_store.checkout_locale %>"
                data-action="submit->stripe-payment#submit">
            <div class="payment-form__element" data-stripe-payment-target="element">
              <p class="payment-form__loading">Loading the secure card form&hellip;</p>
            </div>
            <p class="payment-form__error" data-stripe-payment-target="error" role="alert" hidden></p>
            <button type="submit" class="btn btn--primary btn--lg btn--full" data-stripe-payment-target="submit" disabled>
              <%= cj_icon "lock", size: "1.15em" %>
              <span data-stripe-payment-target="submitLabel">Pay <%= total %></span>
            </button>
            <div class="payment-note">
              <span class="payment-note__label">
                <%= cj_icon "shield-check" %>
                Your card details are handled by Stripe and never reach this store.
              </span>
            </div>
          </form>
        <% elsif @payment_error.present? %>
          <div role="alert" class="checkout__section">
            <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">Payment error</p>
            <p><%= @payment_error %></p>
            <div class="actions actions--start">
              <%= link_to "Back to checkout", checkout_path, class: "btn btn--secondary" %>
            </div>
          </div>
        <% elsif Rails.env.local? %>
          <%# Development only. The card fields live inside Stripe's iframe, so they
              cannot render without a publishable key tied to a real account — this
              panel says exactly which one is missing instead of failing silently. %>
          <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">Card form not connected</p>
          <p class="sub">The real Stripe card form appears here as soon as these keys are set. Test keys are free and take a minute.</p>

          <ol class="setup">
            <li class="setup__step">
              <span class="setup__n">1</span>
              <div>
                <b>Copy your test keys</b>
                <span class="setup__note">Stripe dashboard &rarr; Developers &rarr; API keys, with <b>Test mode</b> on.</span>
              </div>
            </li>
            <li class="setup__step">
              <span class="setup__n">2</span>
              <div>
                <b>Paste them into <code>.env</code></b>
                <pre class="setup__code">STRIPE_SECRET_KEY=sk_test_…
STRIPE_PUBLISHABLE_KEY=pk_test_…</pre>
              </div>
            </li>
            <li class="setup__step">
              <span class="setup__n">3</span>
              <div>
                <b>Forward the webhook, then restart</b>
                <span class="setup__note">Without it a payment succeeds but the order never turns paid.</span>
                <pre class="setup__code">stripe listen --forward-to localhost:5000/webhooks/stripe</pre>
              </div>
            </li>
          </ol>

          <div class="setup__missing">
            <b>Missing right now:</b>
            <%= [("STRIPE_SECRET_KEY" if Payments.secret_key.blank?),
                 ("STRIPE_PUBLISHABLE_KEY" if Payments.publishable_key.blank?)].compact.join(", ") %>
          </div>

          <hr class="rule">
          <p class="sub" style="font-size:var(--fs-caption)">Until then you can record an unpaid order to exercise the rest of the flow. This button does not exist outside development.</p>
          <%= button_to "Record an unpaid test order", payment_path, method: :post, class: "btn btn--secondary btn--full" %>
        <% else %>
          <%# Never offer a way through this page without a payment. %>
          <div role="alert" class="checkout__section">
            <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">Payment unavailable</p>
            <p class="sub">We cannot take payment right now. Your order is saved — please try again in a few minutes, or contact us and we will finish it for you.</p>
            <div class="actions actions--start">
              <%= link_to "Contact us", contact_path, class: "btn btn--secondary" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="card">
        <div class="pay__reassure">
          <div class="trust__item"><%= cj_icon "shield-check" %><span><span class="trust__t">Encrypted</span>256-bit SSL on every field</span></div>
          <div class="trust__item"><%= cj_icon "refresh-cw" %><span><span class="trust__t">30-day guarantee</span>Love it or get a refund</span></div>
          <div class="trust__item"><%= cj_icon "truck" %><span><span class="trust__t">Tracked delivery</span>Tracking sent by email</span></div>
        </div>
      </div>
    </div>

    <div class="stack">
      <%= render "shared/cross_sell" %>
      <%= render "checkouts/summary", flavor: @flavor || Flavor.default, qty: @orders.sum(&:quantity) %>
    </div>
  </div>
</div>
