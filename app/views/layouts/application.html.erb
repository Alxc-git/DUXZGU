<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || current_store&.name || Storefront::PRODUCT_NAME %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || current_product&.description %>">

    <%# Link previews: without these a share on Instagram, WhatsApp or Slack shows
        a bare URL. `canonical` keeps the ?flavor= and ?plan= variants of a page
        from competing with each other in search results. %>
    <% page_title = content_for(:title) || current_store&.name || Storefront::PRODUCT_NAME %>
    <% page_description = content_for(:description) || current_product&.description %>
    <link rel="canonical" href="<%= url_for(only_path: false, params: {}) rescue request.base_url + request.path %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= current_store&.name || Storefront::BRAND %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= request.base_url + request.path %>">
    <meta property="og:image" content="<%= asset_url((@flavor || Flavor.default).scene_image) %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= asset_url((@flavor || Flavor.default).scene_image) %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "site", "data-turbo-track": "reload", defer: true %>
    <%= render "shared/meta_pixel" if meta_pixel_enabled? %>

    <%# Price reels are rolled by site.js; without it they must show the real price. %>
    <noscript>
      <style>.odo .odo__reel{transform:translateY(calc(var(--stop) * var(--odo-cell) * -1));transition:none}</style>
    </noscript>
  </head>

  <body>
    <div class="site">
      <%= render "shared/header", flavor: @flavor || Flavor.default %>

      <% if alert.present? || notice.present? %>
        <div class="page" style="padding-top:var(--space-4);padding-bottom:0">
          <% if alert.present? %>
            <div class="card" role="alert"><%= alert %></div>
          <% end %>
          <% if notice.present? %>
            <div class="card"><%= notice %></div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>

      <%= render "shared/footer" unless content_for?(:hide_footer) %>
      <%= render "shared/buy_bar", flavor: @flavor || Flavor.default unless content_for?(:hide_buy_bar) %>
      <% if current_store && current_product %>
        <%= render "shared/recent_purchases", flavor: @flavor || Flavor.default %>
        <%= render "shared/exit_offer", flavor: @flavor || Flavor.default %>
      <% end %>
      <%= render "shared/meta_pixel_events" if meta_pixel_enabled? %>
    </div>
  </body>
</html>
