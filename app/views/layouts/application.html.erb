<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || current_store&.name || "Boutique" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= current_store&.name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:description) || current_store&.settings&.dig("tagline") %>">
    <meta name="theme-color" content="#111111">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <%= render "storefront/sections/header" %>

    <main id="contenu">
      <% if alert.present? || notice.present? %>
        <div class="page-container flash-stack">
          <% if alert.present? %>
            <div class="flash flash--alert"><%= alert %></div>
          <% end %>
          <% if notice.present? %>
            <div class="flash flash--notice"><%= notice %></div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <%= render "storefront/sections/footer" %>
  </body>
</html>
