<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500&display=swap">

    <%= stylesheet_link_tag "tailwind", "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% auth_screen = controller_path == "admin/sessions" %>

  <body class="admin-shell <%= "admin-shell--auth" if auth_screen %>">
    <div class="admin-shell__body">
      <% unless auth_screen %>
        <aside class="admin-sidebar">
          <%= link_to admin_root_path, class: "admin-sidebar__brand" do %>
            <span class="admin-sidebar__mark"><%= icon "chart", size: 18 %></span>
            <span class="admin-sidebar__wordmark">
              <strong>Boutique</strong>
              <span>Administration</span>
            </span>
          <% end %>

          <div>
            <p class="admin-sidebar__section">Pilotage</p>
            <nav class="admin-sidebar__nav">
              <%= admin_nav_link "Tableau de bord", admin_root_path, "grid" %>
              <%= admin_nav_link "Commandes", admin_orders_path, "package" %>
              <%= admin_nav_link "Clients", admin_customers_path, "users" %>
              <%= admin_nav_link "Approvisionnement", admin_fulfillment_path, "truck" %>
              <%= admin_nav_link "Publicite", admin_ad_spends_path, "trend-up" %>
            </nav>
          </div>

          <div>
            <p class="admin-sidebar__section">Catalogue</p>
            <nav class="admin-sidebar__nav">
              <%= admin_nav_link "Produits", admin_products_path, "bag" %>
              <%= admin_nav_link "Boutiques", admin_stores_path, "store" %>
              <%= admin_nav_link "Reglages", admin_settings_path, "settings" %>
            </nav>
          </div>

          <div class="admin-sidebar__foot">
            <% if defined?(current_admin_user) && current_admin_user.present? %>
              <div class="admin-sidebar__user">
                <strong><%= current_admin_user.email %></strong>
                <span>Connecte</span>
              </div>
            <% end %>

            <%= link_to root_path, class: "admin-sidebar__action", target: "_blank", rel: "noopener" do %>
              <%= icon "external", size: 16 %>
              <span>Voir la boutique</span>
            <% end %>

            <% if defined?(current_admin_user) && current_admin_user.present? %>
              <%= button_to admin_logout_path, method: :delete, class: "admin-sidebar__action" do %>
                <%= icon "logout", size: 16 %>
                <span>Se deconnecter</span>
              <% end %>
            <% end %>
          </div>
        </aside>
      <% end %>

      <main class="admin-main">
        <% if alert.present? %>
          <div class="flash flash--alert"><%= alert %></div>
        <% end %>

        <% if notice.present? %>
          <div class="flash flash--notice"><%= notice %></div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
