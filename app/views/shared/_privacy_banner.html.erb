<aside class="privacy-banner" role="dialog" aria-labelledby="privacy-banner-title" aria-describedby="privacy-banner-copy">
  <div class="page-container privacy-banner__inner">
    <span class="privacy-banner__icon" aria-hidden="true"><%= icon "shield", size: 20 %></span>
    <div class="privacy-banner__copy">
      <strong id="privacy-banner-title"><%= t("privacy_preferences.title") %></strong>
      <p id="privacy-banner-copy">
        <%= t("privacy_preferences.body") %>
        <%= link_to t("privacy_preferences.learn_more"), privacy_policy_path %>
      </p>
    </div>
    <div class="privacy-banner__actions">
      <%= button_to t("privacy_preferences.decline"), privacy_preferences_path,
            params: { analytics: PrivacyConsent::DECLINED }, class: "privacy-banner__choice" %>
      <%= button_to t("privacy_preferences.accept"), privacy_preferences_path,
            params: { analytics: PrivacyConsent::ACCEPTED }, class: "privacy-banner__choice" %>
    </div>
  </div>
</aside>
