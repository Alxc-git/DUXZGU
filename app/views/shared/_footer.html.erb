<footer class="footer">
  <div class="page">
    <div class="footer__in">
      <div class="footer__col footer__col--brand">
        <span class="wordmark"><span class="wordmark__a">Creatine</span><span class="wordmark__b">Jelly</span></span>
        <p class="sub" style="margin-top:8px"><%= t("store.footer.tagline") %></p>
        <div class="footer__social" style="margin-top:12px">
          <% %w[instagram tiktok youtube facebook].each do |brand| %>
            <a class="icon-btn icon-btn--bare" href="#" aria-label="<%= brand.capitalize %>"><%= cj_icon brand %></a>
          <% end %>
        </div>
      </div>

      <%# Two lists rather than three: three never divide evenly on a phone, and
          the admin link had no business being offered to customers. %>
      <div class="footer__col footer__col--links">
        <div class="footer__h"><%= t("store.footer.shop") %></div>
        <%= link_to t("store.nav.product"), product_page_path %><%= link_to t("store.nav.benefits"), product_page_path(anchor: "benefits") %><%= link_to t("store.nav.reviews"), product_page_path(anchor: "reviews") %><%= link_to t("store.nav.cart"), cart_path %>
      </div>
      <div class="footer__col footer__col--links">
        <div class="footer__h"><%= t("store.footer.support") %></div>
        <%= link_to t("store.nav.faq"), product_page_path(anchor: "faq") %><%= link_to t("store.footer.shipping_link"), shipping_policy_path %><%= link_to t("store.footer.refunds_returns"), refunds_path %><%= link_to t("store.footer.contact"), contact_path %>
      </div>
      <div class="footer__col footer__col--news">
        <div class="footer__h"><%= t("store.footer.newsletter_title") %></div>
        <p class="sub"><%= t("store.footer.newsletter_lede") %></p>
        <%# The arrow carries no visible text, so its accessible name has to come
            from the aria-label: without it a screen reader announces "button". %>
        <%= form_with url: newsletter_subscribers_path, method: :post, class: "newsletter", data: { turbo: false } do %>
          <label class="visually-hidden" for="newsletter-email"><%= t("store.footer.newsletter_placeholder") %></label>
          <input class="input" id="newsletter-email" name="email" type="email" required autocomplete="email"
            placeholder="<%= t("store.footer.newsletter_placeholder") %>">
          <button class="btn btn--primary" type="submit" style="padding:0 16px" aria-label="<%= t("store.footer.newsletter_cta") %>"><%= cj_icon "arrow-right", size: "1.15em" %></button>
        <% end %>
        <p class="sub footer__consent"><%= t("store.footer.newsletter_consent") %></p>
      </div>
    </div>

    <div class="footer__pay"><%= render "shared/payment_methods" %></div>

    <div class="footer__bottom">
      <span>© <%= Date.current.year %> <%= current_store&.name || Storefront::BRAND %>. <%= t("store.footer.rights") %></span>
      <span style="display:flex;gap:18px;flex-wrap:wrap"><%= link_to t("store.footer.terms"), terms_path %><%= link_to t("store.footer.refunds"), refunds_path %><%= link_to t("store.footer.shipping_link"), shipping_policy_path %><%= link_to t("store.footer.privacy"), privacy_policy_path %></span>
    </div>
  </div>
</footer>
