<%# A real cross-sell: the variants of this product are sizes, so this offers a
    size the cart does not already hold, at that variant's own price. It must never
    be rendered inside another form — button_to emits a form of its own. %>
<% addon = current_product&.available_variants.to_a.reject { |v| current_cart.variant_ids.include?(v.id) }.first %>
<% if addon.present? %>
  <div class="card card--accent cross-sell">
    <p class="eyebrow eyebrow--accent">Add another size</p>
    <div class="cross-sell__row">
      <span class="checkout__thumb cross-sell__media">
        <%= image_tag (local_assigns[:flavor] || @flavor || Flavor.default).packshot, alt: "" %>
      </span>
      <div class="cross-sell__body">
        <div class="stat__label"><%= current_product.display_name %> &middot; <%= addon.display_name %></div>
        <div class="stat__note">Ships in the same parcel, no extra delivery</div>
        <div class="cross-sell__price"><%= addon.formatted_price %></div>
      </div>
    </div>
    <%= button_to cart_lines_path,
          params: { product_id: addon.product_id, variant_id: addon.id, quantity: 1 },
          class: "btn btn--outline btn--sm btn--full" do %>
      <%= cj_icon "plus", size: "1.05em" %> Add to my order
    <% end %>
  </div>
<% end %>
