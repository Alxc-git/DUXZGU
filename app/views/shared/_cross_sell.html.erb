<%# Offer another flavour at the same size as an existing cart line. The
    flavour is part of the cart line key, so this creates a distinct line even
    though both products use the same size variant. %>
<% suggestion = current_cart.flavor_suggestion %>
<% if suggestion.present? %>
  <% line = suggestion[:line] %>
  <% flavor = suggestion[:flavor] %>
  <div class="card card--accent cross-sell">
    <div class="cross-sell__head">
      <p class="eyebrow eyebrow--accent"><%= t("store.cart.cross_sell_flavor") %></p>
      <span class="cross-sell__hint"><%= t("store.cart.cross_sell_hint") %></span>
    </div>
    <div class="cross-sell__row">
      <span class="checkout__thumb cross-sell__media">
        <%= storefront_image_tag flavor.checkout_image, alt: "", sizes: "100px" %>
      </span>
      <div class="cross-sell__body">
        <div class="stat__label"><%= flavor.name %> &middot; <%= line.variant.display_name %></div>
        <div class="stat__note"><%= flavor.note %></div>
        <div class="cross-sell__price"><%= line.variant.formatted_price %></div>
      </div>
      <%= button_to cart_lines_path,
            params: { product_id: line.product.id, variant_id: line.variant.id, quantity: 1, flavor: flavor.slug },
            class: "btn btn--outline btn--sm", form: { class: "cross-sell__action" } do %>
        <%= cj_icon "plus", size: "1.05em" %> <%= t("store.cart.cross_sell_add_flavor") %>
      <% end %>
    </div>
  </div>
<% end %>
