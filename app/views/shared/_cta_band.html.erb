<section class="cta-card" data-flavor-theme style="--active-flavor:<%= flavor.color_var %>">
  <div class="cta-card__media"><%= storefront_image_tag flavor.card_image, alt: "#{flavor.name} · DUWZGU Creatine Jelly", sizes: "(min-width: 620px) 50vw, 100vw", data: { flavor_image: true } %></div>
  <div class="cta-card__body">
    <p class="eyebrow"><%= t("premium.cta.eyebrow") %></p>
    <h2><%= t("premium.cta.title") %></h2><p class="sub"><%= t("premium.cta.lede") %></p>
    <% if current_product && selected_purchase_variant %>
      <div class="actions">
        <%= button_to cart_lines_path, params: buy_now_params(quantity: 1), form: { data: { flavor_purchase: true } }, class: "btn btn--primary btn--lg" do %>
          <%= t("premium.hero.cta") %><%= cj_icon "arrow-right" %>
        <% end %>
        <% unless local_assigns[:hide_product_link] %><%= link_to t("store.hero.see_product"), product_page_path, class: "text-link" %><% end %>
      </div>
    <% end %>
    <p class="cta-card__note"><%= cj_icon "shield-check" %><%= t("store.cta.note") %></p>
  </div>
</section>
