<%# The competitor's tub, drawn rather than photographed: no licensed shot of a
    rival product is needed, and it stays crisp at any size and in any theme. %>
<svg class="tub" viewBox="0 0 120 120" role="img" aria-label="Tub of creatine powder" focusable="false">
  <defs>
    <linearGradient id="tub-body" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#14141A"/>
      <stop offset="38%" stop-color="#33333D"/>
      <stop offset="72%" stop-color="#1B1B22"/>
      <stop offset="100%" stop-color="#0E0E12"/>
    </linearGradient>
    <linearGradient id="tub-lid" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1A1A20"/>
      <stop offset="42%" stop-color="#3E3E4A"/>
      <stop offset="100%" stop-color="#121217"/>
    </linearGradient>
    <linearGradient id="tub-scoop" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#EDEDF0"/>
      <stop offset="100%" stop-color="#A9A9B4"/>
    </linearGradient>
  </defs>

  <ellipse cx="56" cy="108" rx="40" ry="6" fill="#000" opacity=".55"/>
  <rect x="30" y="34" width="52" height="72" rx="7" fill="url(#tub-body)"/>
  <rect x="27" y="24" width="58" height="14" rx="5" fill="url(#tub-lid)"/>
  <rect x="36" y="52" width="40" height="22" rx="3" fill="#000" opacity=".5"/>
  <rect x="40" y="58" width="32" height="3" rx="1.5" fill="#55555F"/>
  <rect x="40" y="65" width="22" height="3" rx="1.5" fill="#3E3E48"/>

  <path d="M78 84c9-4 20-2 24 5 3 6-2 12-9 13-8 1-16-3-18-9-1-4 0-7 3-9z" fill="url(#tub-scoop)"/>
  <path d="M99 89c6-3 13-8 16-13" stroke="#C9C9D2" stroke-width="4" stroke-linecap="round" fill="none"/>
  <ellipse cx="84" cy="88" rx="11" ry="4" fill="#fff" opacity=".9"/>
</svg>
