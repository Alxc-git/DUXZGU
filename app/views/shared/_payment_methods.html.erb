<%# The methods this store actually takes — see PaymentMarksHelper#accepted_payment_methods.
    Nothing renders when none is wired up, rather than advertising a checkout that would fail. %>
<% methods = accepted_payment_methods %>
<% if methods.any? %>
  <div class="payment-note <%= local_assigns[:css_class] %>">
    <span class="payment-note__label">
      <%= cj_icon "lock" %><%= local_assigns[:label] || t("store.payments.accepted") %>
    </span>
    <%= payment_marks methods, label: t("store.payments.methods_label"),
          class: local_assigns[:size] == "sm" ? "payment-marks--sm" : nil %>
  </div>
<% end %>
