<%# A real cutoff: the hour is a store setting and weekends are skipped, so the
    countdown never promises a dispatch that will not happen. %>
<% window = DispatchWindow.for(current_store) %>
<p class="cutoff" data-cutoff="<%= window.cutoff_at.iso8601 %>">
  <%= cj_icon "truck" %>
  <% if window.same_day? %>
    <span><%= t("store.dispatch.same_day_html", time: tag.b(distance_of_time_in_words(window.seconds_left), data: { cutoff_clock: true })).html_safe %></span>
  <% else %>
    <% ships_on = (l(window.ships_on, format: :long) rescue window.ships_on.strftime("%A")) %>
    <span><%= t("store.dispatch.ships_html", day: tag.b(ships_on)).html_safe %></span>
  <% end %>
</p>
