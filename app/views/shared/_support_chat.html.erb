<%# Support assistant. The launcher and panel are markup; every answer comes from
    POST /support/chat, where Rails builds the verified order context and Groq only
    phrases it. Nothing about an order is decided in the browser. %>
<div class="chat" data-chat>
  <button type="button" class="chat__launcher" data-chat-toggle
          aria-expanded="false" aria-controls="support-panel">
    <span class="chat__launcher-icon"><%= cj_icon "chat" %></span>
    <span class="chat__launcher-label"><%= t("store.assistant.launcher") %></span>
    <span class="chat__dot" aria-hidden="true"></span>
  </button>

  <section class="chat__panel" id="support-panel" data-chat-panel hidden
           role="dialog" aria-modal="false" aria-label="<%= t("store.assistant.label") %>">
    <header class="chat__head">
      <span class="chat__avatar" aria-hidden="true"><%= cj_icon "sparkle" %></span>
      <div class="chat__id">
        <b><%= t("store.assistant.title", store: current_store.name) %></b>
        <span class="chat__status"><span class="chat__pulse" aria-hidden="true"></span><%= t("store.assistant.status") %></span>
      </div>
      <button type="button" class="chat__close" data-chat-toggle aria-label="<%= t("store.assistant.close") %>">
        <%= cj_icon "close" %>
      </button>
    </header>

    <div class="chat__log" data-chat-log role="log" aria-live="polite" aria-atomic="false">
      <div class="chat__msg chat__msg--bot">
        <p><%= t("store.assistant.greeting", store: current_store.name) %></p>
      </div>
      <div class="chat__chips" data-chat-chips role="group" aria-label="<%= t("store.assistant.label") %>">
        <button type="button" class="chat__chip" data-chat-suggest><%= t("store.assistant.chip_order") %></button>
        <button type="button" class="chat__chip" data-chat-suggest><%= t("store.assistant.chip_dose") %></button>
        <button type="button" class="chat__chip" data-chat-suggest><%= t("store.assistant.chip_refund") %></button>
      </div>
    </div>

    <form class="chat__form" data-chat-form>
      <label class="visually-hidden" for="chat-input"><%= t("store.assistant.message") %></label>
      <input class="input chat__input" id="chat-input" name="message" autocomplete="off"
             placeholder="<%= t("store.assistant.placeholder") %>" maxlength="1000" data-chat-input required>
      <button type="submit" class="chat__send" data-chat-send aria-label="<%= t("store.assistant.send") %>">
        <%= cj_icon "send" %>
      </button>
    </form>
    <p class="chat__foot"><%= t("store.assistant.foot_html", link: link_to(t("store.assistant.foot_link"), privacy_policy_path)).html_safe %></p>
  </section>
</div>
