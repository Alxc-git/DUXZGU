<aside class="checkout-help">
  <span class="checkout-help__icon"><%= icon "headset", size: 20 %></span>
  <div>
    <strong>Une question ?</strong>
    <span>Notre equipe repond sous 24h, du lundi au vendredi.</span>
    <% if current_store&.support_email.present? %>
      <%= mail_to current_store.support_email, class: "checkout-help__link" do %>
        <span><%= current_store.support_email %></span>
        <%= icon "chevron-right", size: 15 %>
      <% end %>
    <% end %>
  </div>
</aside>
