<%# lines: [{variant:, product:, quantity:, amount:}], totals: {subtotal:, shipping_cents:, total:} %>
<aside class="order-summary">
  <h2 class="order-summary__title">
    <span><%= t("checkout.your_order") %></span>
    <% if local_assigns[:edit_path].present? %>
      <%= link_to t("common.edit"), edit_path, class: "order-summary__edit" %>
    <% end %>
  </h2>

  <ul class="order-summary__lines" role="list">
    <% lines.each do |line| %>
      <li class="order-summary__line">
        <span class="order-summary__media">
          <%= variant_image_tag line[:variant], alt: "#{line[:product].display_name} #{line[:variant]&.display_name}",
                thumb: 90, loading: "lazy", decoding: "async" %>
          <span class="order-summary__badge"><%= line[:quantity] %></span>
        </span>
        <span class="order-summary__info">
          <strong><%= line[:product].display_name %></strong>
          <span><%= line[:variant]&.display_name %></span>
        </span>
        <span class="order-summary__price"><%= line[:amount] %></span>
      </li>
    <% end %>
  </ul>

  <dl class="order-summary__rows">
    <div class="order-summary__row">
      <dt><%= t("cart.subtotal") %></dt>
      <dd><%= totals[:subtotal] %></dd>
    </div>
    <% if totals[:discount_cents].to_i.positive? %>
      <div class="order-summary__row order-summary__row--discount">
        <dt><%= totals[:discount_label] %></dt>
        <dd>&minus;<%= MoneyFormatter.format(totals[:discount_cents], current_store.currency) %></dd>
      </div>
    <% end %>

    <div class="order-summary__row">
      <dt><%= t("cart.shipping") %></dt>
      <dd>
        <% if totals[:shipping_cents].to_i.zero? %>
          <span class="order-summary__free"><%= t("common.free") %></span>
        <% else %>
          <%= MoneyFormatter.format(totals[:shipping_cents], current_store.currency) %>
        <% end %>
      </dd>
    </div>
    <div class="order-summary__row order-summary__row--total">
      <dt><%= t("cart.total") %></dt>
      <dd><%= totals[:total] %></dd>
    </div>
  </dl>

  <p class="order-summary__taxes"><%= t("common.taxes_included") %></p>

  <%= render "shared/order_perks", list_class: "order-summary__perks" %>
</aside>
