<div class="stack">
  <div class="card">
    <div style="display:flex;align-items:baseline;margin-bottom:var(--space-4)">
      <h2 style="font-size:var(--fs-title)">Your cart (<%= current_cart.count %>)</h2>
      <%= link_to "Edit cart", cart_path,
            style: "margin-left:auto;font-size:var(--fs-caption)" %>
    </div>
    <% current_cart.lines.each do |line| %>
      <div class="checkout__item">
        <span class="checkout__thumb">
          <%= image_tag flavor.packshot, alt: "" %>
        </span>
        <div style="min-width:0;flex:1">
          <div class="stat__label"><%= line.product.display_name %></div>
          <div class="stat__note"><%= line.variant.display_name %> · Qty <%= line.quantity %></div>
          <div style="font-family:var(--font-display);color:var(--accent);font-size:1.25rem;margin-top:10px">
            <%= line.formatted_total %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%= render "shared/free_shipping_bar" %>

  <div class="card">
    <h2 style="font-size:var(--fs-title);margin-bottom:var(--space-4)">Order summary</h2>
    <div class="checkout__section" style="gap:10px">
      <div class="checkout__line"><span>Subtotal</span><b><%= current_cart.formatted_subtotal %></b></div>
      <div class="checkout__line"><span>Shipping</span><b><%= current_cart.shipping_cents.zero? ? "Free" : current_cart.formatted_shipping %></b></div>
      <% if current_cart.discount? %>
        <div class="checkout__line checkout__line--discount"><span><%= current_cart.offer.label %></span><b>-<%= current_cart.formatted_discount %></b></div>
      <% end %>
      <hr class="rule">
      <div class="checkout__line checkout__line--total"><span>Total</span><span><%= current_cart.formatted_total %></span></div>
      <div class="promo">
        <input class="input" placeholder="Promo code">
        <span class="btn btn--secondary">Apply</span>
      </div>
    </div>
  </div>

  <div class="card">
    <div style="display:flex;gap:14px;align-items:flex-start">
      <span class="feature-icon"><%= cj_icon "shield-check" %></span>
      <div>
        <div class="stat__label">100% safe &amp; secure checkout</div>
        <div class="stat__note">Your information is protected with 256-bit SSL encryption.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <p class="eyebrow eyebrow--accent" style="margin-bottom:12px">Need help with your order?</p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-6)">
      <div class="trust__item"><%= cj_icon "message-circle" %><span><span class="trust__t">Live chat</span>Mon–Fri 9AM–6PM EST</span></div>
      <div class="trust__item"><%= cj_icon "mail" %><span><span class="trust__t">Email us</span>support@creatinejelly.com</span></div>
    </div>
  </div>
</div>
