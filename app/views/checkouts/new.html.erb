<% content_for :title, "Checkout | #{current_store.name}" %>
<% content_for :hide_footer, true %>
<% content_for :hide_buy_bar, true %>

<div class="page stack" style="padding-top:var(--space-8)">
  <%= render "checkouts/steps", current: 1 %>

  <%= render "shared/page_head",
        title: "Checkout",
        sub: "Delivery details, then payment. Two minutes.",
        aside: link_to(cart_path, class: "page-head__back") {
          safe_join([ cj_icon("chevron-left"), "Back to cart" ])
        } %>

  <%= form_with model: @form,
        scope: :checkout_form,
        url: checkout_path,
        method: :post,
        class: "checkout",
        data: {
          turbo: false,
          controller: "address-autocomplete",
          address_autocomplete_url_value: address_suggestions_path,
          address_autocomplete_details_url_value: address_details_path,
          address_autocomplete_status_label_value: "suggestions"
        } do |form| %>
    <div class="stack">
      <% if @form.errors.any? %>
        <div class="alert alert--alert" role="alert">
          <span class="alert__emoji" aria-hidden="true">✋</span>
          <div class="alert__text">
            <b><%= pluralize(@form.errors.size, "field") %> to fix</b>
            <ul class="alert__list">
              <% @form.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="card checkout__section">
        <div style="display:flex;align-items:baseline;gap:12px">
          <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">1. Customer information</p>
        </div>
        <%= render layout: "checkouts/field", locals: { label: "Email address" } do %>
          <%= form.email_field :email, class: "input", placeholder: "you@example.com",
                autocomplete: "email", inputmode: "email", required: true %>
        <% end %>
        <p class="field__hint"><%= cj_icon "mail" %>Your confirmation and tracking link go here.</p>
      </div>

      <div class="card checkout__section">
        <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">2. Shipping address</p>
        <div class="checkout__grid checkout__grid--2">
          <%= render layout: "checkouts/field", locals: { label: "First name" } do %>
            <%= form.text_field :first_name, class: "input", autocomplete: "given-name", required: true %>
          <% end %>
          <%= render layout: "checkouts/field", locals: { label: "Last name" } do %>
            <%= form.text_field :last_name, class: "input", autocomplete: "family-name", required: true %>
          <% end %>
        </div>

        <%= render layout: "checkouts/field", locals: { label: "Street address" } do %>
        <div class="autocomplete">
          <%= form.text_field :address_line1,
                class: "input",
                placeholder: "123 rue Sainte-Catherine",
                autocomplete: "shipping street-address",
                required: true,
                role: "combobox",
                aria: { autocomplete: "list", expanded: false, controls: "address-suggestions" },
                data: {
                  autocomplete_kind: "address",
                  address_autocomplete_target: "query",
                  action: "input->address-autocomplete#search keydown->address-autocomplete#navigate focus->address-autocomplete#search blur->address-autocomplete#blur"
                } %>
          <ul id="address-suggestions" role="listbox" class="autocomplete__list" hidden
              data-autocomplete-kind="address"
              data-address-autocomplete-target="list"></ul>
        </div>
        <% end %>

        <%= render layout: "checkouts/field", locals: { label: "Apartment, suite", required: false } do %>
          <%= form.text_field :address_line2, class: "input",
                autocomplete: "shipping address-line2",
                data: { address_autocomplete_target: "next" } %>
        <% end %>

        <div class="checkout__grid checkout__grid--2">
          <%= render layout: "checkouts/field", locals: { label: "City" } do %>
            <%= form.text_field :city, class: "input", autocomplete: "shipping address-level2",
                  required: true, data: { address_autocomplete_target: "city" } %>
          <% end %>
          <%= render layout: "checkouts/field", locals: { label: "Province / State" } do %>
            <%= form.text_field :province, class: "input",
                  autocomplete: "shipping address-level1", data: { address_autocomplete_target: "province" } %>
          <% end %>
        </div>

        <div class="checkout__grid checkout__grid--2">
          <%= render layout: "checkouts/field", locals: { label: "Postal code" } do %>
          <div class="autocomplete">
            <%= form.text_field :postal_code,
                  class: "input",
                  placeholder: "H2X 1Z4",
                  autocomplete: "shipping postal-code",
                  required: true,
                  role: "combobox",
                  aria: { autocomplete: "list", expanded: false, controls: "postal-suggestions" },
                  data: {
                    autocomplete_kind: "postal",
                    address_autocomplete_target: "query postalCode",
                    action: "input->address-autocomplete#search keydown->address-autocomplete#navigate focus->address-autocomplete#search blur->address-autocomplete#blur"
                  } %>
            <ul id="postal-suggestions" role="listbox" class="autocomplete__list" hidden
                data-autocomplete-kind="postal"
                data-address-autocomplete-target="list"></ul>
          </div>
          <% end %>

          <%= render layout: "checkouts/field", locals: { label: "Country" } do %>
          <span class="select">
            <%= form.select :country, checkout_form_country_options, {}, class: "input",
                  data: { address_autocomplete_target: "country" } %>
            <span class="select__chev"><%= cj_icon "chevron-down" %></span>
          </span>
          <% end %>
        </div>

        <%= render layout: "checkouts/field", locals: { label: "Phone" } do %>
          <%= form.telephone_field :phone, class: "input", placeholder: "(514) 555-0123",
                autocomplete: "tel", inputmode: "tel", required: true %>
        <% end %>
        <p class="field__hint"><%= cj_icon "truck" %>Carriers use it for delivery updates. Nothing else.</p>
        <p class="autocomplete__status" role="status" aria-live="polite" data-address-autocomplete-target="status"></p>
      </div>

      <div class="card checkout__section">
        <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">3. Shipping method</p>
        <%= render "shared/option", title: "Standard shipping", note: "Calculated by store settings", price: current_cart.formatted_shipping, selected: true %>
        <div class="trust__item"><%= cj_icon "truck" %>Orders are prepared after payment confirmation</div>
      </div>

      <div class="card checkout__section">
        <div style="display:flex;align-items:baseline;gap:12px">
          <p class="eyebrow eyebrow--accent" style="font-size:var(--fs-body-sm)">4. Payment</p>
          <span style="margin-left:auto;font-size:var(--fs-caption);color:var(--text-muted)">Next step: Stripe or PayPal.</span>
        </div>
        <%= render "shared/option", title: "Secure payment", note: "Card with Stripe, PayPal when configured", selected: true %>

        <button class="btn btn--primary btn--lg btn--full" type="submit">
          <%= cj_icon "lock", size: "1.15em" %> Continue to payment
        </button>
        <p style="font-size:var(--fs-caption);color:var(--text-faint);text-align:center">
          By completing your purchase, you agree to the store privacy policy.
        </p>
      </div>
    </div>

    <div class="checkout__aside">
      <%= render "checkouts/summary", flavor: @flavor, qty: @qty %>
    </div>
  <% end %>
</div>
