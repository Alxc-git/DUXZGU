<%# step: :address, :payment or :done %>
<% steps = [
     { key: :cart,    label: "Panier" },
     { key: :address, label: "Livraison" },
     { key: :payment, label: "Paiement" },
     { key: :done,    label: "Confirmation" }
   ] %>
<% order = steps.map { |s| s[:key] } %>
<% current = order.index(step) %>

<ol class="progress" role="list">
  <% steps.each_with_index do |item, index| %>
    <%
      state = if index < current
                "progress__step--done"
              elsif index == current
                "progress__step--current"
              end
    %>
    <li class="progress__step <%= state %>">
      <span class="progress__mark">
        <% if index < current %>
          <%= icon "check", size: 13 %>
        <% else %>
          <%= index + 1 %>
        <% end %>
      </span>
      <span class="progress__label"><%= item[:label] %></span>
    </li>
  <% end %>
</ol>
