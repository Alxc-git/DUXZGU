# Copy this file to .env for local development. bin/dev uses Foreman, which
# loads .env automatically. Never commit real Stripe or supplier secrets.

# Public storefront identity and transactional email.
APP_HOST=localhost
SUPPORT_EMAIL=contact@example.com
MAIL_FROM=contact@example.com

# Required in production for order confirmations, tracking and contact messages.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Stripe test mode keys from the Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Set this after running:
# stripe listen --forward-to localhost:3000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_local_webhook_secret

# PayPal is wired directly rather than through Stripe, which does not offer it in
# every merchant country. Leave these empty and the PayPal button simply does not
# render; the card form is unaffected. Create an app at developer.paypal.com.
# PAYPAL_ENV stays "sandbox" until you are ready to take real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# From the PayPal dashboard, Webhooks section, after pointing it at
# https://your-domain/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Optional: create a local admin when running bin/rails db:seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-local-only

# Optional: CJ supplier credentials for fulfillment tests.
CJ_API_KEY=
CJ_ACCESS_TOKEN=

# Meta ads. The pixel id is public and is rendered into the page; the Conversions
# API token is a server secret and must never reach a view, a log or Git.
# Without the token the browser pixel still works and Purchase is simply not sent.
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
# Optional, defaults to the version pinned in app/services/meta.rb.
META_GRAPH_API_VERSION=
# Optional. Set it to route events to Events Manager > Test Events instead of
# production traffic. Leave it empty in production.
META_TEST_EVENT_CODE=

# Optional: address autocomplete on the checkout form. Without a key the
# lookup falls back to Photon, which needs no signup but asks for fair use.
# A Geoapify key raises the quota: https://myprojects.geoapify.com
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional: Groq support assistant. Defaults to openai/gpt-oss-20b.
GROQ_API_KEY=
GROQ_MODEL=

# In production, point this at a mounted Railway volume when admin-uploaded
# Active Storage files must survive deployments. Catalogue images ship in Git.
ACTIVE_STORAGE_ROOT=
