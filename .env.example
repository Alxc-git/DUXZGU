# Copy this file to .env for local development. bin/dev uses Foreman, which
# loads .env automatically. Never commit real Stripe or supplier secrets.

# Stripe test mode keys from the Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Set this after running:
# stripe listen --forward-to localhost:3000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_local_webhook_secret

# Optional: create a local admin when running bin/rails db:seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-local-only

# Optional: CJ supplier credentials for fulfillment tests.
CJ_API_KEY=
CJ_ACCESS_TOKEN=
